# Dual-subdomain deploy config. Copy to .env and fill in. Consumed by deploy.sh
# (local, AWS-side) and exported into the router compose (AMR_DOMAIN etc.).

# --- domains ---
AMR_DOMAIN=amr.openelis-global.org
ANALYZERS_DOMAIN=analyzers.openelis-global.org
LETSENCRYPT_EMAIL=devops@openelis-global.org
# Set to "true" to hit Let's Encrypt STAGING while iterating (avoids rate limits).
LETSENCRYPT_STAGING=false

# --- branches deployed to each subdomain ---
AMR_BRANCH=feat/782-ogc-782-microbiology-mvp-m7-release-surveillance-readiness
ANALYZERS_BRANCH=codex/ogc-1054-analyzer-qc-mvp

# --- AWS / host (the m7i-flex.xlarge provisioned for this) ---
REGION=us-west-2
INSTANCE_ID=i-012e8514a3e3ee629
EIP=35.85.196.163
SG_ID=sg-006f1521af7b63185
OS_USER=ubuntu
SSH_KEY=~/.ssh/amr-analyzers-key.pem

# --- on-box layout (checkouts created by `deploy.sh configure`) ---
EDGE_DIR=/opt/oe-edge
AMR_DIR=/opt/oe-amr
ANALYZERS_DIR=/opt/oe-analyzers
