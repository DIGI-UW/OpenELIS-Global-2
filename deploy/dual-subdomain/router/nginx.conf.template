# =============================================================================
# Umbrella reverse proxy — Host-based dispatch to two isolated OpenELIS stacks
# =============================================================================
# Rendered by docker-entrypoint.sh via envsubst. Variables:
#   ${AMR_DOMAIN}        — microbiology MVP stack (OGC-782)
#   ${ANALYZERS_DOMAIN}  — analyzer types & mapping stack (OGC-1054, incl. harness)
#   ${AMR_CERT} ${AMR_KEY} ${ANALYZERS_CERT} ${ANALYZERS_KEY}
#       — per-domain cert paths, resolved by the entrypoint to the Let's Encrypt
#         lineage when present, else a per-domain self-signed fallback.
#
# The two backend stacks bind NO host ports; they are reached only over the
# shared external "oe-edge" Docker network by the aliases their override files
# attach: amr-frontend / amr-oe and analyzers-frontend / analyzers-oe.
#
# DO NOT edit the rendered nginx.conf — edit this template.
# =============================================================================

worker_processes 1;

events { worker_connections 1024; }

http {
    # Docker's embedded DNS. Combined with $variable upstreams below, this defers
    # name resolution to request time, so the router starts and stays up even if a
    # backend stack is not running yet (returns 502 until it is, instead of nginx
    # refusing to start on an unresolvable upstream).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # WebSocket upgrade passthrough (Grist relies on it).
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    # -------------------------------------------------------------------------
    # HTTP :80 — ACME HTTP-01 challenge for all domains, then redirect to HTTPS.
    # certbot writes tokens under /var/www/certbot for whichever domain is being
    # validated, so all server_names share the same webroot.
    # -------------------------------------------------------------------------
    server {
        listen 80;
        server_name ${AMR_DOMAIN} ${ANALYZERS_DOMAIN} ${GRIST_DOMAIN};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }
    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # -------------------------------------------------------------------------
    # amr.openelis-global.org  ->  amr stack (build.docker-compose.yml)
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        server_name ${AMR_DOMAIN};

        ssl_certificate     ${AMR_CERT};
        ssl_certificate_key ${AMR_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        absolute_redirect off;

        # Reviewer overlay assets, served locally by the router. This prefix is
        # more specific than "location /", so it wins over the SPA proxy below.
        location /__review/ {
            alias /etc/nginx/review/;
            types { application/javascript js; application/json json; }
            default_type application/octet-stream;
            add_header Cache-Control "no-store";
        }

        # Frontend. Host is rewritten to "localhost" so a Vite dev server (if the
        # stack runs one) accepts the forwarded request (Vite 5 allowedHosts is
        # strict); harmless for the static-nginx runtime build, which ignores Host.
        # sub_filter injects the reviewer overlay before </head>; Accept-Encoding
        # is cleared so nginx sees uncompressed HTML to substitute into.
        location / {
            set $amr_frontend "amr-frontend";
            proxy_pass http://$amr_frontend;
            proxy_redirect off;
            proxy_set_header Host localhost;
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '</head>' '<script src="/__review/widget.js" data-instance="amr" data-label="Microbiology MVP (OGC-782)"></script></head>';
        }
        location /api/ {
            set $amr_oe "amr-oe";
            proxy_pass https://$amr_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
        location /rest/ {
            set $amr_oe "amr-oe";
            proxy_pass https://$amr_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
    }

    # -------------------------------------------------------------------------
    # analyzers.openelis-global.org  ->  analyzers stack (harness chain)
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        server_name ${ANALYZERS_DOMAIN};

        ssl_certificate     ${ANALYZERS_CERT};
        ssl_certificate_key ${ANALYZERS_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        absolute_redirect off;

        location /__review/ {
            alias /etc/nginx/review/;
            types { application/javascript js; application/json json; }
            default_type application/octet-stream;
            add_header Cache-Control "no-store";
        }

        location / {
            set $an_frontend "analyzers-frontend";
            proxy_pass http://$an_frontend;
            proxy_redirect off;
            proxy_set_header Host localhost;
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '</head>' '<script src="/__review/widget.js" data-instance="analyzers" data-label="Analyzer Types &amp; Mapping (OGC-1054)"></script></head>';
        }
        location /api/ {
            set $an_oe "analyzers-oe";
            proxy_pass https://$an_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
        location /rest/ {
            set $an_oe "analyzers-oe";
            proxy_pass https://$an_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
    }

    # -------------------------------------------------------------------------
    # grist.openelis-global.org -> Grist UAT authoring UI (basic-auth gated).
    # Grist runs login-less in this light mode; the router enforces access.
    # SSO (Grist OIDC against an IdP) is the intended upgrade — see grist/README.md.
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        server_name ${GRIST_DOMAIN};

        ssl_certificate     ${GRIST_CERT};
        ssl_certificate_key ${GRIST_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        auth_basic "OpenELIS UAT authoring";
        auth_basic_user_file /etc/nginx/grist.htpasswd;

        client_max_body_size 32m;

        location / {
            set $grist_up "grist";
            proxy_pass http://$grist_up:8484;
            proxy_redirect off;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            # Strip the basic-auth Authorization header after the gate: Grist only
            # accepts a 'Bearer' scheme and 401s on 'Basic'.
            proxy_set_header Authorization "";
            # Trusted-proxy auth: hand Grist the authenticated basic-auth username
            # (an email) so it logs the reviewer straight into the doc UI.
            proxy_set_header X-Remote-User $remote_user;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # -------------------------------------------------------------------------
    # Catch-all: any other Host lands here. Reuse amr's cert as an arbitrary
    # default (a self-signed fallback always exists) and refuse the connection —
    # no legitimate traffic should reach this block.
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl default_server;
        server_name _;
        ssl_certificate     ${AMR_CERT};
        ssl_certificate_key ${AMR_KEY};
        return 444;
    }
}
