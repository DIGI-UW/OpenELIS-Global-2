##
# Build Stage
#
FROM ubuntu:focal AS build


##
# Prerequesites
#
# Keep the base image's Ubuntu repositories. The forced Azure mirror stalled
# package downloads and exhausted all three shared-build attempts.
RUN apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=60 \
        --allow-releaseinfo-change -y update \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=60 \
        -y upgrade \
    && DEBIAN_FRONTEND=noninteractive apt-get \
        -o Acquire::Retries=5 -o Acquire::http::Timeout=60 \
        -y --no-install-recommends install \
        openssl net-tools default-jdk maven \
        apache2-utils git apt-transport-https \
        ca-certificates curl gnupg lsb-release software-properties-common \
    && apt-get clean

##
# The certs service runs scripts/certs/ensure-install-keys.sh with this image's
# openssl and keytool; no key is built into the image.
RUN mkdir -p /etc/openelis-global /etc/ssl/private /etc/ssl/certs
