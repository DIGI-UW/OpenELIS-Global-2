# Build from the repository root. Only tools and the initializer are packaged;
# installation keys are created after persistent volumes are mounted.
FROM eclipse-temurin:21-jre-noble
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/openelis-global /etc/ssl/private /etc/ssl/certs
COPY scripts/certs/ensure-install-keys.sh /usr/local/bin/ensure-install-keys
ENTRYPOINT ["/bin/sh", "/usr/local/bin/ensure-install-keys"]
