{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "es2021"],
    "resolveJsonModule": true,
    "noEmit": true,
    "target": "esnext"
  }
}
