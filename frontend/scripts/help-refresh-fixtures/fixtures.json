    "101": {
      "corpusKey": "user/en",
      "title": "Working with Patients",
      "labels": [],
      "ancestorTitles": ["User Manual"],
      "version": 7,
      "webuiPath": "/wiki/spaces/OG/pages/101/Working+with+Patients",
      "attachments": ["att-diagram"],
      "adf": {
        "type": "doc",
        "version": 1,
        "content": [
          {
            "type": "heading",
            "attrs": { "level": 1 },
            "content": [{ "type": "text", "text": "Working with Patients" }]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Register a patient, then order a test. The diagram below shows the full flow."
              }
            ]
          },
          {
            "type": "mediaSingle",
            "content": [
              {
                "type": "media",
                "attrs": {
                  "id": "att-diagram",
                  "type": "file",
                  "collection": "contentId-101",
                  "alt": "Patient registration flow"
                }
              }
            ]
          },
          {
            "type": "panel",
            "attrs": { "panelType": "info" },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Patient IDs are generated automatically."
                  }
                ]
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Enter name and date of birth."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      { "type": "text", "text": "Select the test panel." }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": { "language": "json" },
            "content": [
              {
                "type": "text",
                "text": "{ \"patient\": \"12345\", \"status\": \"ready\" }"
              }
            ]
          }
        ]
      }
    },
