{
  "name": "openelis-addon-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "OpenELIS add-on: an MCP server for AI agents (read-only, per-agent tokens, audited)",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --max-old-space-size=64 dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
