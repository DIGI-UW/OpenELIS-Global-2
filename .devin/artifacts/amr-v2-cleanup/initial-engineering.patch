-      <div class="gr-schema-grid">
-        <div>
-          <h3>RIS dataset</h3>
-          <ul class="gr-compact-list">
-            <li>Country, collection year, national subset</li>
-            <li>Specimen, pathogen, antimicrobial</li>
-            <li>Sex, age group, infection origin</li>
-            <li>Counts R, I, S</li>
-            <li>AST not reported and performed without interpretation</li>
