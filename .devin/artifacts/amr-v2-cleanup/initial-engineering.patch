-        </div>
-      </div>
-      <div class="table-responsive">
-        <table class="table table-sm">
-          <thead><tr><th>Meaning</th><th>Canonical handling</th><th>Boundary mappings</th></tr></thead>
-          <tbody>
-            <tr><td>Organism</td><td>Internal stable concept with scientific display and versioned status</td><td>Local LIS, SNOMED where licensed/available, WHO GLASS pathogen, WHONET alias</td></tr>
-            <tr><td>Specimen</td><td>Internal stable specimen concept</td><td>Local code, SNOMED, WHO GLASS specimen category, WHONET alias</td></tr>
-            <tr><td>Antibiotic</td><td>Internal stable antimicrobial concept</td><td>Local code, LOINC test code, WHO GLASS antimicrobial, WHONET alias</td></tr>
-            <tr><td>Measurement</td><td>Comparator + numeric value + UCUM unit</td><td>Source text retained verbatim for traceability</td></tr>
-            <tr><td>Interpretation</td><td>S / I / R plus authority-specific meaning</td><td>EUCAST <code>I</code> is preserved as increased exposure; CLSI meaning is not silently substituted</td></tr>
