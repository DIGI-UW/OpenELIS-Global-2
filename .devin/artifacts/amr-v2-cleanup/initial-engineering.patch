-        </div>
-        <div>
-          <h3>SAMPLE dataset</h3>
-          <ul class="gr-compact-list">
-            <li>Country, collection year, national subset</li>
-            <li>Specimen, sex, age group, infection origin</li>
-            <li>Patients sampled for bacterial isolation</li>
-            <li>GLASS-pathogen positive</li>
-            <li>Non-GLASS positive and negative/no-growth</li>
-          </ul>
-        </div>
-      </div>
