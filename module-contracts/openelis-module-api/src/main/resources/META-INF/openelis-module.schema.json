{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/schemas/openelis-module/1",
  "title": "OpenELIS module manifest (META-INF/openelis-module.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "version", "requires"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}$",
      "description": "Lower-case id; every namespace of the module derives from it"
    },
    "kind": { "type": "string", "enum": ["provider", "module"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of the module"
    },
    "description": { "type": "string" },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "contact": { "type": "string" }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openelis"],
      "properties": {
        "openelis": {
          "type": "string",
          "minLength": 1,
          "description": "Semver range with a lower bound: the minimum OpenELIS version the module was built against"
        },
        "coreApi": { "type": "string", "minLength": 1 },
        "spi": { "type": "string", "minLength": 1 },
        "frontendContract": { "type": "string", "minLength": 1 },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" }
    },
    "required": { "type": "boolean" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basePackages": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
        },
        "activator": { "type": "string", "minLength": 1 },
        "entities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "liquibase": { "type": "string", "minLength": 1 },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spi", "class"],
            "properties": {
              "spi": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "class": { "type": "string", "minLength": 1 },
              "order": { "type": "integer" }
            }
          }
        },
        "libraries": { "type": "array", "items": { "type": "string" } },
        "comment": { "type": "string" }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.-]*$" },
          "description": { "type": "string" },
          "defaultRoles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elementId", "parent", "displayKey"],
        "properties": {
          "elementId": { "type": "string", "pattern": "^menu_mod_[a-z0-9_]+$" },
          "parent": { "type": "string", "minLength": 1 },
          "displayKey": { "type": "string", "minLength": 1 },
          "toolTipKey": { "type": "string" },
          "actionURL": { "type": "string" },
          "presentationOrder": { "type": "integer" },
          "icon": { "type": "string" },
          "permission": { "type": "string" }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "messages": { "type": "string", "minLength": 1 },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expose"],
            "properties": {
              "path": { "type": "string", "pattern": "^/m/[a-z][a-z0-9-]{2,40}(/.*)?$" },
              "exact": { "type": "boolean" },
              "expose": { "type": "string", "pattern": "^\\./.+" },
              "permission": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "expose"],
            "properties": {
              "slot": { "type": "string", "minLength": 1 },
              "expose": { "type": "string", "pattern": "^\\./.+" },
              "order": { "type": "integer" },
              "permission": { "type": "string" }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9.-]*$" },
              "type": { "type": "string", "enum": ["string", "integer", "boolean", "url"] },
              "default": { "type": ["string", "integer", "boolean", "null"] },
              "description": { "type": "string" },
              "exposeToFrontend": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
