#!/usr/bin/env python3
"""Checkout-isolated OpenELIS development stack interface."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
from typing import NamedTuple, Sequence
from urllib.error import URLError
from urllib.request import Request, urlopen


class StackContext(NamedTuple):
    repo_root: Path
    project: str
    project_dir: Path
    compose_files: tuple[Path, ...]


LOCAL_DOMAINS = {"localhost", "127.0.0.1", "::1"}

# Application images: (compose service, image variable in the harness compose
# files, published repository, image name when built with `up --build`).
APPLICATION_IMAGES = (
    ("frontend.openelis.org", "DEV_STACK_FRONTEND_IMAGE", "openelis-global-2-frontend-dev", "frontend"),
    ("oe.openelis.org", "DEV_STACK_BACKEND_IMAGE", "openelis-global-2-dev", "backend"),
    ("astm-simulator", "DEV_STACK_MOCK_IMAGE", "openelis-global-2-analyzer-mock", "analyzer-mock"),
    ("openelis-analyzer-bridge", "DEV_STACK_BRIDGE_IMAGE", "openelis-global-2-analyzer-bridge", "analyzer-bridge"),
)
SUBMODULE_SERVICES = {
    "tools/analyzer-mock-server": "astm-simulator",
    "tools/openelis-analyzer-bridge": "openelis-analyzer-bridge",
}
# Checkout paths baked into the backend development image; the WAR is mounted.
BACKEND_IMAGE_INPUTS = ("Dockerfile.dev", "install", "tomcat/client-certificates")
# Frontend files baked into the development image; src and public are mounted.
FRONTEND_IMAGE_INPUTS = ("package.json", "package-lock.json", "vite.config.ts", "index.html", "tsconfig.json")

def slugify(value: str, limit: int = 28) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-") or "worktree"
    return slug[:limit].rstrip("-")


def make_context(repo_root: Path) -> StackContext:
    root = repo_root.resolve()
    digest = hashlib.sha256(str(root).encode("utf-8")).hexdigest()[:8]
    project = f"oe2-{slugify(root.name)}-{digest}-dev"
    project_dir = root / "projects" / "analyzer-harness"
    compose_files = (
        project_dir / "docker-compose.dev.yml",
        project_dir / "docker-compose.base.yml",
        project_dir / "docker-compose.analyzer-test.yml",
        project_dir / "docker-compose.letsencrypt.yml",
        project_dir / "docker-compose.worktree.yml",
    )
    return StackContext(root, project, project_dir, compose_files)


def read_dotenv(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        values[key] = value
    return values


def is_local_domain(domain: str) -> bool:
    return domain.lower() in LOCAL_DOMAINS


def build_environment(context: StackContext) -> dict[str, str]:
    uat_scenarios_enabled = os.environ.get("OE_UAT_SCENARIOS_ENABLED", "true")
    environment = os.environ.copy()
    for key, value in read_dotenv(context.repo_root / ".env").items():
        environment.setdefault(key, value)
    environment["DEV_STACK_PROJECT"] = context.project
    environment["OE_UAT_SCENARIOS_ENABLED"] = uat_scenarios_enabled
    domain = environment.get("LETSENCRYPT_DOMAIN", "localhost")
    environment["LETSENCRYPT_DOMAIN"] = domain
    environment.setdefault("LETSENCRYPT_BRIDGE_DOMAIN", f"bridge.{domain}")
    if is_local_domain(domain):
        environment.setdefault("DEV_STACK_INGRESS_BIND_ADDRESS", "127.0.0.1")
        environment.setdefault("DEV_STACK_HTTP_PORT", "0")
        environment.setdefault("DEV_STACK_HTTPS_PORT", "0")
        environment.setdefault("DEV_STACK_TLS", "local-ca")
    else:
        environment.setdefault("DEV_STACK_INGRESS_BIND_ADDRESS", "0.0.0.0")
        environment.setdefault("DEV_STACK_HTTP_PORT", "80")
        environment.setdefault("DEV_STACK_HTTPS_PORT", "443")
        environment.setdefault("DEV_STACK_TLS", "letsencrypt")
    digest = int(hashlib.sha256(str(context.repo_root).encode("utf-8")).hexdigest()[:8], 16)
    environment["ANALYZER_NETWORK_NAMESPACE"] = context.project
    environment["ANALYZER_SUBNET_PREFIX"] = f"10.{64 + digest % 160}"
    for _, variable, repository, _ in APPLICATION_IMAGES:
        environment.setdefault(variable, published_image(environment, repository))
    return environment


def compose_command(context: StackContext, *arguments: str) -> list[str]:
    command = [
        "docker",
        "compose",
        "-p",
        context.project,
        "--project-directory",
        str(context.project_dir),
    ]
    env_file = context.repo_root / ".env"
    if env_file.is_file():
        command.extend(("--env-file", str(env_file)))
    for compose_file in context.compose_files:
        command.extend(("-f", str(compose_file)))
    command.extend(arguments)
    return command


def required_submodules() -> tuple[str, ...]:
    return (
        "dataexport",
        "tools/analyzer-mock-server",
        "tools/openelis-analyzer-bridge",
    )


def parse_published_port(value: str) -> int:
    match = re.search(r":(\d+)\s*$", value)
    if not match:
        raise ValueError(f"Could not parse Docker published port from: {value!r}")
    return int(match.group(1))


def validate_down_options(remove_volumes: bool, confirmed: bool) -> None:
    if remove_volumes and not confirmed:
        raise ValueError("Removing stack volumes requires both --volumes and --yes")


def run(
    command: Sequence[str],
    *,
    cwd: Path,
    environment: dict[str, str],
    capture: bool = False,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(command),
        cwd=cwd,
        env=environment,
        check=True,
        text=True,
        capture_output=capture,
    )


def output(
    command: Sequence[str], *, cwd: Path, environment: dict[str, str]
) -> str:
    return run(command, cwd=cwd, environment=environment, capture=True).stdout.strip()


def service_is_running(
    context: StackContext, environment: dict[str, str], service: str
) -> bool:
    result = run(
        compose_command(context, "ps", "--status", "running", "-q", service),
        cwd=context.project_dir,
        environment=environment,
        capture=True,
    )
    return bool(result.stdout.strip())


def start_services(
    context: StackContext,
    environment: dict[str, str],
    *,
    refresh_running_backend: bool,
) -> None:
    run(
        compose_command(context, "up", "-d", "--no-build", "--remove-orphans"),
        cwd=context.project_dir,
        environment=environment,
    )
    if refresh_running_backend:
        run(
            compose_command(
                context,
                "up",
                "-d",
                "--no-build",
                "--no-deps",
                "--force-recreate",
                "oe.openelis.org",
            ),
            cwd=context.project_dir,
            environment=environment,
        )


def ensure_local_env(context: StackContext) -> None:
    env_file = context.repo_root / ".env"
    example = context.repo_root / ".env.example"
    if not env_file.exists() and example.is_file():
        shutil.copyfile(example, env_file)
        print(f"Created local {env_file.relative_to(context.repo_root)} from .env.example")


def has_checkout(path: Path) -> bool:
    return path.is_dir() and any(entry.name != ".git" for entry in path.iterdir())


def initialize_submodule(
    context: StackContext, environment: dict[str, str], relative_path: str
) -> None:
    command = ["git", "submodule", "update", "--init", "--recursive", relative_path]
    try:
        run(command, cwd=context.repo_root, environment=environment)
    except subprocess.CalledProcessError:
        run(
            [
                "git",
                "submodule",
                "update",
                "--init",
                "--recursive",
                "--checkout",
                "--force",
                relative_path,
            ],
            cwd=context.repo_root,
            environment=environment,
        )


def ensure_submodules(context: StackContext, environment: dict[str, str]) -> tuple[str, ...]:
    """Initialize empty submodules and leave populated ones exactly as checked out.

    Returns the submodules whose checkout differs from the recorded pin.
    """
    changed: list[str] = []
    for relative_path in required_submodules():
        path = context.repo_root / relative_path
        if not has_checkout(path):
            initialize_submodule(context, environment, relative_path)
            continue
        recorded = output(
            ["git", "rev-parse", f"HEAD:{relative_path}"],
            cwd=context.repo_root,
            environment=environment,
        )
        checked_out = output(
            ["git", "rev-parse", "HEAD"], cwd=path, environment=environment
        )
        changes = output(
            ["git", "status", "--porcelain"], cwd=path, environment=environment
        )
        if checked_out == recorded and not changes:
            continue
        notice = (
            f"{relative_path}: checked out {checked_out[:7]} "
            f"(recorded pin {recorded[:7]})"
        )
        if changes:
            notice += ", with uncommitted changes"
        print(notice)
        changed.append(relative_path)
    return tuple(changed)


def heal_war_mount(context: StackContext) -> None:
    war = context.repo_root / "target" / "OpenELIS-Global.war"
    if war.is_dir():
        try:
            war.rmdir()
        except OSError as error:
            raise RuntimeError(f"Expected a WAR file but found a non-empty directory at {war}") from error


def build_application(context: StackContext, environment: dict[str, str]) -> None:
    java = context.repo_root / "scripts" / "run-java21"
    dataexport = context.repo_root / "dataexport" / "pom.xml"
    run(
        [str(java), "mvn", "-q", "-f", str(dataexport), "install", "-DskipTests", "-Dmaven.test.skip=true"],
        cwd=context.repo_root,
        environment=environment,
    )
    run(
        [str(java), "mvn", "-q", "package", "-DskipTests", "-Dmaven.test.skip=true"],
        cwd=context.repo_root,
        environment=environment,
    )
    war = context.repo_root / "target" / "OpenELIS-Global.war"
    if not war.is_file():
        raise RuntimeError(f"Build did not produce {war}")


def bootstrap_analyzer_harness(
    context: StackContext, environment: dict[str, str], *, skip_submodules: bool = False
) -> None:
    arguments = [str(context.project_dir / "bootstrap.sh")]
    if skip_submodules:
        arguments.append("--skip-submodules")
    if is_local_domain(environment["LETSENCRYPT_DOMAIN"]):
        arguments.append("--local")
    run(
        arguments,
        cwd=context.project_dir,
        environment=environment,
    )


def build_images(context: StackContext, environment: dict[str, str]) -> None:
    """Build every application image from the checkout and run those instead."""
    for _, variable, _, name in APPLICATION_IMAGES:
        environment[variable] = f"{context.project}-{name}:dev"
    run(
        compose_command(context, "build", *(service for service, _, _, _ in APPLICATION_IMAGES)),
        cwd=context.project_dir,
        environment=environment,
    )


def published_image(environment: dict[str, str], repository: str) -> str:
    namespace = environment.get("DEV_STACK_IMAGE_NAMESPACE", "itechuw")
    tag = environment.get("DEV_STACK_IMAGE_TAG", "develop")
    return f"{namespace}/{repository}:{tag}"


def frontend_image_differences(
    context: StackContext, environment: dict[str, str], image: str
) -> list[str]:
    """Name the baked-in frontend files that differ between the image and the checkout."""
    try:
        listing = output(
            ["docker", "run", "--rm", "--entrypoint", "sha256sum", image,
             *(f"/app/{name}" for name in FRONTEND_IMAGE_INPUTS)],
            cwd=context.repo_root,
            environment=environment,
        )
    except subprocess.CalledProcessError:
        return list(FRONTEND_IMAGE_INPUTS)
    published = {}
    for line in listing.splitlines():
        digest, _, path = line.partition(" ")
        published[Path(path.strip()).name] = digest
    return [
        name
        for name in FRONTEND_IMAGE_INPUTS
        if published.get(name)
        != hashlib.sha256((context.repo_root / "frontend" / name).read_bytes()).hexdigest()
    ]


def pull_image(context: StackContext, environment: dict[str, str], image: str) -> None:
    """Pull an image; on failure keep an existing copy or explain the way out."""
    try:
        run(["docker", "pull", image], cwd=context.repo_root, environment=environment)
        return
    except subprocess.CalledProcessError:
        try:
            run(["docker", "image", "inspect", image], cwd=context.repo_root, environment=environment, capture=True)
        except subprocess.CalledProcessError:
            raise RuntimeError(
                f"Could not pull {image}. Check the network and registry access, "
                "or rerun with --build to build the images from this checkout."
            ) from None
    print(f"Warning: could not pull {image}; using the copy already on this machine", file=sys.stderr)


def backend_image_differences(
    context: StackContext, environment: dict[str, str], image: str
) -> list[str]:
    """Name the backend image inputs that differ from the commit the image was built from."""
    try:
        revision = output(
            ["docker", "image", "inspect", "--format",
             '{{index .Config.Labels "org.opencontainers.image.revision"}}', image],
            cwd=context.repo_root,
            environment=environment,
        )
        if not revision or revision == "<no value>":
            return []
        changed = output(
            ["git", "diff", "--name-only", revision, "--", *BACKEND_IMAGE_INPUTS],
            cwd=context.repo_root,
            environment=environment,
        ).splitlines()
    except subprocess.CalledProcessError:
        return []
    return [
        path
        for path in BACKEND_IMAGE_INPUTS
        if any(line == path or line.startswith(path + "/") for line in changed)
    ]


def image_record(context: StackContext) -> Path:
    return context.repo_root / ".dev-stack" / "images.json"


def record_images(context: StackContext, environment: dict[str, str]) -> None:
    """Remember which images this stack runs, for later `up --skip-build` restarts."""
    record = image_record(context)
    record.parent.mkdir(parents=True, exist_ok=True)
    record.write_text(
        json.dumps({variable: environment[variable] for _, variable, _, _ in APPLICATION_IMAGES}, indent=2) + "\n",
        encoding="utf-8",
    )


def reuse_recorded_images(context: StackContext, environment: dict[str, str]) -> None:
    """Select the images the last `up` ran, unless a variable was set explicitly."""
    record = image_record(context)
    if not record.is_file():
        return
    recorded = json.loads(record.read_text(encoding="utf-8"))
    for _, variable, _, _ in APPLICATION_IMAGES:
        if variable in recorded and variable not in os.environ:
            environment[variable] = recorded[variable]


def pull_images(
    context: StackContext, environment: dict[str, str], changed_submodules: Sequence[str]
) -> None:
    """Pull the published development images and say what they cannot reflect."""
    for _, variable, _, _ in APPLICATION_IMAGES:
        pull_image(context, environment, environment[variable])
    images = {service: environment[variable] for service, variable, _, _ in APPLICATION_IMAGES}
    for path, service in SUBMODULE_SERVICES.items():
        if path in changed_submodules:
            print(
                f"Warning: {service} runs the published {images[service]}, not the {path} "
                "checkout. Rerun with --build to run the checkout.",
                file=sys.stderr,
            )
    differences = frontend_image_differences(context, environment, images["frontend.openelis.org"])
    if differences:
        changed = ", ".join(f"frontend/{name}" for name in differences)
        print(
            f"Warning: {changed} differ from {images['frontend.openelis.org']}. "
            "Rerun with --build if the frontend needs them.",
            file=sys.stderr,
        )
    backend = images["oe.openelis.org"]
    differences = backend_image_differences(context, environment, backend)
    if differences:
        print(
            f"Warning: {', '.join(differences)} differ from the commit {backend} was built from. "
            "Rerun with --build if the backend runtime needs them.",
            file=sys.stderr,
        )


def published_port(context: StackContext, service: str, target: int, environment: dict[str, str]) -> int:
    result = run(
        compose_command(context, "port", service, str(target)),
        cwd=context.project_dir,
        environment=environment,
        capture=True,
    )
    return parse_published_port(result.stdout)


def endpoint_environment(context: StackContext, environment: dict[str, str]) -> dict[str, str]:
    domain = environment["LETSENCRYPT_DOMAIN"]
    https_port = published_port(context, "proxy", 443, environment)
    authority = domain if https_port == 443 else f"{domain}:{https_port}"
    endpoints = {
        "BASE_URL": f"https://{authority}",
        "OE_BACKEND_URL": f"https://localhost:{published_port(context, 'oe.openelis.org', 8443, environment)}",
        "FHIR_URL": f"https://localhost:{published_port(context, 'fhir.openelis.org', 8443, environment)}",
        "DB_PORT": str(published_port(context, "db.openelis.org", 5432, environment)),
        "COMPOSE_PROJECT_NAME": context.project,
    }
    subnet_prefix = environment["ANALYZER_SUBNET_PREFIX"]
    endpoints.update(
        {
            "MOCK_SIMULATOR_URL": f"http://localhost:{published_port(context, 'astm-simulator', 8080, environment)}",
            "ANALYZER_BRIDGE_URL": f"https://localhost:{published_port(context, 'openelis-analyzer-bridge', 8443, environment)}",
            "ANALYZER_NETWORK_NAMESPACE": context.project,
            "ANALYZER_SUBNET_PREFIX": subnet_prefix,
            "ANALYZER_GENEXPERT_IP": f"{subnet_prefix}.20.10",
            "ANALYZER_BRIDGE_DESTINATION": f"tcp://{subnet_prefix}.20.2:12001",
        }
    )
    return endpoints


def ensure_local_tls_trust(context: StackContext, environment: dict[str, str]) -> None:
    if environment["DEV_STACK_TLS"].lower() != "local-ca":
        return
    if not is_local_domain(environment["LETSENCRYPT_DOMAIN"]):
        raise ValueError("DEV_STACK_TLS=local-ca is only supported for loopback hosts")
    print(
        "Checking local HTTPS trust. First use installs this machine's development "
        "certificate authority in the system trust store and may request administrator "
        "authentication. Later starts reuse it.",
        flush=True,
    )
    trust_environment = {**environment, "TRUST_STORES": "system"}
    try:
        # mkcert skips installation when this authority is already trusted.
        run(["mkcert", "-install"], cwd=context.repo_root, environment=trust_environment)
    except subprocess.CalledProcessError as error:
        raise RuntimeError(
            "Local HTTPS trust setup did not complete; no build was started. "
            "Run scripts/dev-stack up in an interactive terminal and complete "
            "the administrator prompt. For unattended starts, first run "
            "TRUST_STORES=system mkcert -install interactively on this machine."
        ) from error


def configure_local_tls(context: StackContext, environment: dict[str, str]) -> None:
    if not is_local_domain(environment["LETSENCRYPT_DOMAIN"]):
        raise ValueError("DEV_STACK_TLS=local-ca is only supported for loopback hosts")
    directory = context.repo_root / ".dev-stack" / "tls"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    certificate, key = directory / "localhost.pem", directory / "localhost-key.pem"
    run(
        [
            "mkcert", "-cert-file", str(certificate), "-key-file", str(key),
            "localhost", "127.0.0.1", "::1",
        ],
        cwd=context.repo_root,
        environment=environment,
    )
    key.chmod(0o600)
    # Only the leaf certificate/key enter this worktree's proxy. The CA key
    # stays in mkcert's per-user directory and is never copied to a container.
    for source, destination in (
        (certificate, "proxy:/etc/nginx/certs/apache-selfsigned.crt"),
        (key, "proxy:/etc/nginx/keys/apache-selfsigned.key"),
    ):
        run(
            compose_command(context, "cp", str(source), destination),
            cwd=context.project_dir,
            environment=environment,
        )
    reload_proxy(context, environment)


def configure_tls(context: StackContext, environment: dict[str, str]) -> None:
    tls_mode = environment["DEV_STACK_TLS"].lower()
    if tls_mode == "self-signed":
        return
    if tls_mode == "local-ca":
        configure_local_tls(context, environment)
        return
    if tls_mode != "letsencrypt":
        raise ValueError("DEV_STACK_TLS must be local-ca, self-signed or letsencrypt")
    if is_local_domain(environment["LETSENCRYPT_DOMAIN"]):
        raise ValueError("DEV_STACK_TLS=letsencrypt requires a public LETSENCRYPT_DOMAIN")
    if not environment.get("LETSENCRYPT_EMAIL"):
        raise ValueError("DEV_STACK_TLS=letsencrypt requires LETSENCRYPT_EMAIL")
    proxy = run(
        compose_command(context, "ps", "-q", "proxy"),
        cwd=context.project_dir,
        environment=environment,
        capture=True,
    ).stdout.strip()
    if not proxy:
        raise RuntimeError("The worktree proxy is not running")
    tls_environment = environment.copy()
    tls_environment["DEV_STACK_PROXY_CONTAINER_ID"] = proxy
    run(
        [str(context.project_dir / "scripts" / "generate-letsencrypt-certs.sh")],
        cwd=context.project_dir,
        environment=tls_environment,
    )
    run(
        compose_command(context, "restart", "proxy"),
        cwd=context.project_dir,
        environment=environment,
    )


def verify_tls(context: StackContext, environment: dict[str, str]) -> None:
    if environment["DEV_STACK_TLS"].lower() != "self-signed":
        # Verify hostname and operating-system trust even when readiness is
        # skipped. The shared headless readiness probe permits self-signed TLS.
        try:
            run(
                [
                    "curl", "--silent", "--show-error", "--output", os.devnull,
                    "--connect-timeout", "10", "--max-time", "30",
                    "--retry", "5", "--retry-delay", "1",
                    "--retry-connrefused", "--retry-max-time", "10",
                    endpoint_environment(context, environment)["BASE_URL"] + "/",
                ],
                cwd=context.repo_root,
                environment=environment,
            )
        except subprocess.CalledProcessError as error:
            raise RuntimeError(
                "HTTPS verification failed after certificate setup. Check the "
                "reported curl error and docs/dev_setup.md before retrying up."
            ) from error


def reload_proxy(context: StackContext, environment: dict[str, str]) -> None:
    for nginx_arguments in (["nginx", "-t"], ["nginx", "-s", "reload"]):
        run(
            compose_command(context, "exec", "-T", "proxy", *nginx_arguments),
            cwd=context.project_dir,
            environment=environment,
        )


def print_endpoints(context: StackContext, environment: dict[str, str], shell_exports: bool = False) -> None:
    endpoints = endpoint_environment(context, environment)
    for name, value in endpoints.items():
        if shell_exports:
            print(f"export {name}={shlex.quote(value)}")
        else:
            print(f"{name}={value}")


def playwright_base_url(context: StackContext, environment: dict[str, str]) -> str:
    return environment.get("BASE_URL") or endpoint_environment(context, environment)["BASE_URL"]


def playwright_command(arguments: Sequence[str]) -> list[str]:
    forwarded = list(arguments)
    has_project = any(
        argument == "--project" or argument.startswith("--project=")
        for argument in forwarded
    )
    if not has_project:
        forwarded.insert(0, "--project=core-app")
    return ["npm", "run", "pw:test", "--", *forwarded]


def wait_for_login(context: StackContext, environment: dict[str, str]) -> None:
    base_url = endpoint_environment(context, environment)["BASE_URL"]
    wait_environment = environment.copy()
    wait_environment["BASE_URL"] = base_url
    run(
        [str(context.repo_root / "scripts" / "e2e" / "wait-for-openelis-login.sh")],
        cwd=context.repo_root,
        environment=wait_environment,
    )


def initialize_harness_scenarios(
    context: StackContext, environment: dict[str, str]
) -> None:
    endpoints = endpoint_environment(context, environment)
    seed_environment = {
        **environment,
        "BASE_URL": endpoints["BASE_URL"],
        "MOCK_URL": endpoints["MOCK_SIMULATOR_URL"],
        "BRIDGE_ADMIN_URL": endpoints["ANALYZER_BRIDGE_URL"],
    }
    run(
        ["bash", str(context.project_dir / "seed-analyzers.sh"), "--ensure-connections"],
        cwd=context.repo_root,
        environment=seed_environment,
    )


def cleanup_analyzer_networks(context: StackContext, environment: dict[str, str]) -> None:
    try:
        base = endpoint_environment(context, environment)["MOCK_SIMULATOR_URL"]
        with urlopen(f"{base}/analyzers", timeout=5) as response:
            payload = json.load(response)
        for analyzer in payload.get("analyzers", []):
            name = analyzer.get("name")
            if not name:
                continue
            request = Request(f"{base}/analyzers/{name}", method="DELETE")
            with urlopen(request, timeout=10):
                pass
    except (subprocess.CalledProcessError, URLError, TimeoutError, ValueError, KeyError) as error:
        print(f"Warning: could not clean analyzer networks through the mock API: {error}", file=sys.stderr)


def doctor(context: StackContext, environment: dict[str, str]) -> None:
    if environment["DEV_STACK_TLS"].lower() == "local-ca" and not shutil.which("mkcert", path=environment.get("PATH")):
        raise RuntimeError(
            "Missing local HTTPS prerequisite: mkcert (macOS: brew install mkcert). "
            "Then rerun scripts/dev-stack up; it handles the one-time system trust setup. "
            "See docs/dev_setup.md for other platforms."
        )
    for command in ("git", "docker", "mvn", "bash", "curl", "envsubst"):
        if not shutil.which(command, path=environment.get("PATH")):
            raise RuntimeError(f"Missing source-build prerequisite: {command}")
    for path in context.compose_files:
        if not path.is_file():
            raise RuntimeError(f"Missing compose file: {path}")
    run(["docker", "info"], cwd=context.repo_root, environment=environment, capture=True)
    run([str(context.repo_root / "scripts" / "run-java21")], cwd=context.repo_root, environment=environment)
    if not is_local_domain(environment["LETSENCRYPT_DOMAIN"]):
        if environment["DEV_STACK_TLS"] == "letsencrypt" and not environment.get("LETSENCRYPT_EMAIL"):
            raise RuntimeError("Domain mode requires LETSENCRYPT_EMAIL when DEV_STACK_TLS=letsencrypt")
    print(f"{context.project}: prerequisites are ready")


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="dev-stack",
        description="Run the full checkout-isolated OpenELIS + analyzer development stack.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    up = subparsers.add_parser("up")
    images = up.add_mutually_exclusive_group()
    images.add_argument(
        "--skip-build",
        action="store_true",
        help="Reuse this checkout's WAR and the images the last up ran; build and pull nothing.",
    )
    images.add_argument(
        "--build",
        action="store_true",
        help="Build the application images from this checkout instead of using the published ones.",
    )
    up.add_argument("--no-wait", action="store_true")
    up.add_argument("--no-scenarios", action="store_true")
    down = subparsers.add_parser("down")
    down.add_argument("--volumes", action="store_true")
    down.add_argument("--yes", action="store_true")
    subparsers.add_parser("status")
    subparsers.add_parser("url")
    subparsers.add_parser("env")
    subparsers.add_parser("config")
    subparsers.add_parser("doctor")
    playwright = subparsers.add_parser(
        "playwright",
        help="Run Playwright with this worktree's URL and shared authentication setup.",
    )
    logs = subparsers.add_parser("logs")
    logs.add_argument("services", nargs="*")
    logs.add_argument("--follow", "-f", action="store_true")
    args, remaining = parser.parse_known_args(list(argv))
    if args.command == "playwright":
        args.playwright_args = remaining
    elif remaining:
        parser.error(f"unrecognized arguments: {' '.join(remaining)}")
    return args


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    context = make_context(Path(__file__).resolve().parent.parent)
    environment = build_environment(context)

    if args.command == "doctor":
        doctor(context, environment)
    elif args.command == "config":
        bootstrap_analyzer_harness(context, environment)
        run(compose_command(context, "config"), cwd=context.project_dir, environment=environment)
    elif args.command == "up":
        ensure_local_env(context)
        environment = build_environment(context)
        doctor(context, environment)
        ensure_local_tls_trust(context, environment)
        changed_submodules = ensure_submodules(context, environment)
        bootstrap_analyzer_harness(context, environment, skip_submodules=True)
        backend_was_running = service_is_running(
            context, environment, "oe.openelis.org"
        )
        heal_war_mount(context)
        if not args.skip_build:
            build_application(context, environment)
            if args.build:
                build_images(context, environment)
            else:
                pull_images(context, environment, changed_submodules)
            record_images(context, environment)
        elif not (context.repo_root / "target" / "OpenELIS-Global.war").is_file():
            raise RuntimeError("--skip-build requires target/OpenELIS-Global.war")
        else:
            reuse_recorded_images(context, environment)
            images = [environment[variable] for _, variable, _, _ in APPLICATION_IMAGES]
            run(["docker", "image", "inspect", *images], cwd=context.repo_root, environment=environment, capture=True)
        start_services(
            context,
            environment,
            refresh_running_backend=backend_was_running and not args.skip_build,
        )
        reload_proxy(context, environment)
        configure_tls(context, environment)
        verify_tls(context, environment)
        if not args.no_wait:
            wait_for_login(context, environment)
            if not args.no_scenarios:
                initialize_harness_scenarios(context, environment)
        print_endpoints(context, environment)
    elif args.command == "down":
        validate_down_options(args.volumes, args.yes)
        cleanup_analyzer_networks(context, environment)
        down_args = ["down", "--remove-orphans"]
        if args.volumes:
            down_args.append("--volumes")
        run(compose_command(context, *down_args), cwd=context.project_dir, environment=environment)
    elif args.command == "status":
        run(compose_command(context, "ps"), cwd=context.project_dir, environment=environment)
        try:
            print_endpoints(context, environment)
        except subprocess.CalledProcessError:
            pass
    elif args.command == "url":
        print(endpoint_environment(context, environment)["BASE_URL"])
    elif args.command == "env":
        print_endpoints(context, environment, shell_exports=True)
    elif args.command == "playwright":
        playwright_environment = environment.copy()
        playwright_environment.update(endpoint_environment(context, environment))
        playwright_environment["BASE_URL"] = playwright_base_url(context, environment)
        print(f"Running Playwright against {playwright_environment['BASE_URL']}")
        run(
            playwright_command(args.playwright_args),
            cwd=context.repo_root / "frontend",
            environment=playwright_environment,
        )
    elif args.command == "logs":
        log_args = ["logs"]
        if args.follow:
            log_args.append("--follow")
        log_args.extend(args.services)
        run(compose_command(context, *log_args), cwd=context.project_dir, environment=environment)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError, subprocess.CalledProcessError) as error:
        print(f"dev-stack: {error}", file=sys.stderr)
        raise SystemExit(1)
