<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    OGC-1147 Manual & RDT QC persistence - source-typed QC results.

    qc_result is the single store for all three sources: analyzer (ASTM), bench
    quantitative (MANUAL) and qualitative control line (RDT). Extending it keeps
    the Levey-Jennings chart, dashboard, export, rule engine and auto-NCE bridge
    working with no adapter layer, and reduces "all QC for this test today" to a
    WHERE clause instead of a cross-table union. Qualitative outcomes live in their
    own nullable column rather than as magic numbers in result_value.

    No row rewrites and no backfills. Ordering within this file is load-bearing:
    `source` is added and backfilled by DEFAULT first, the shape CHECK is added
    while every row still satisfies it, and only then are the NOT NULLs relaxed.
    Reversing the last two steps would leave a window in which a valueless
    quantitative row is insertable.
    -->

    <changeSet author="samuelmale" id="qc-021-qc-result-source-and-qualitative">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="clinlims" tableName="qc_result"/>
            <not>
                <columnExists schemaName="clinlims" tableName="qc_result" columnName="source"/>
            </not>
        </preConditions>
        <comment>Source-type discriminant + qualitative outcome + captured-target snapshot on qc_result</comment>
        <addColumn schemaName="clinlims" tableName="qc_result">
            <!-- ASTM = analyzer-transmitted (every pre-existing row, via the default).
                 MANUAL = bench quantitative. RDT = qualitative control line.
                 OGC-427/428 add their own values with a CHECK amendment when they land;
                 the once-proposed WORKPLAN/QC_MODULE/ANALYZER_IMPORT/ANALYZER_LIST
                 vocabulary is not in either of those tickets and is not seeded here. -->
            <column name="source" type="VARCHAR(10)" defaultValue="ASTM">
                <constraints nullable="false"/>
            </column>
            <!-- VALID/INVALID for RDT control lines, PASS/FAIL for manual runs.
                 NULL for ASTM rows, which carry a number instead. -->
            <column name="qualitative_outcome" type="VARCHAR(10)"/>
            <!-- Target snapshot: the effective target in force at capture, copied onto
                 the row so a later edit of a configured target (OGC-1148's
                 test_qc_target) can never rewrite QC history. Target CONFIGURATION is
                 out of scope here and belongs entirely to OGC-1148; only the snapshot
                 lives on the result. -->
            <column name="expected_value" type="NUMERIC(15,5)"/>
            <column name="uncertainty" type="NUMERIC(15,5)"/>
            <!-- Lab unit. The QC-fail signal is scoped by test AND lab unit, and no
                 QC table carries a test_section today — qc_result scopes by
                 (test_id, instrument_id) only, which a bench run cannot use because it
                 has no instrument. numeric(10) matches test_section.id. -->
            <column name="test_section_id" type="numeric(10)"/>
            <!-- Free-text kit/control designation for RDT runs, where the control is a
                 cassette lot rather than a levelled control material. -->
            <column name="control_label" type="VARCHAR(120)"/>
        </addColumn>

        <addForeignKeyConstraint
            baseTableSchemaName="clinlims" baseTableName="qc_result" baseColumnNames="test_section_id"
            referencedTableSchemaName="clinlims" referencedTableName="test_section" referencedColumnNames="id"
            constraintName="fk_qc_result_test_section"/>

        <!-- Dashboard and export both filter by source over a date window; the existing
             indexes lead with control_lot_id / instrument_id, neither of which a manual
             row necessarily has. -->
        <createIndex schemaName="clinlims" tableName="qc_result" indexName="idx_qc_result_source_date">
            <column name="source"/>
            <column name="run_date_time" descending="true"/>
        </createIndex>
        <!-- The affected-analysis window is keyed (test, lab unit, time). -->
        <createIndex schemaName="clinlims" tableName="qc_result" indexName="idx_qc_result_test_section_date">
            <column name="test_section_id"/>
            <column name="test_id"/>
            <column name="run_date_time" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- Must run BEFORE the NOT NULL relaxations below. Every existing row is
         source='ASTM' with a non-null result_value, so this validates without a table
         rewrite. This is the first CHECK constraint in liquibase/qc/ — statuses in this
         directory are unconstrained VARCHARs validated only in Java. Form copied from
         analyzer/004-012-create-analyzer-qc-rule.xml. -->
    <changeSet author="samuelmale" id="qc-022-qc-result-shape-check">
        <preConditions onFail="MARK_RAN">
            <columnExists schemaName="clinlims" tableName="qc_result" columnName="source"/>
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM pg_constraint WHERE conname = 'chk_qc_result_source_shape'
                </sqlCheck>
            </not>
        </preConditions>
        <comment>A row is either quantitative with a value, or RDT-qualitative with an outcome — never neither</comment>
        <sql>
            ALTER TABLE clinlims.qc_result
            ADD CONSTRAINT chk_qc_result_source
            CHECK (source IN ('ASTM', 'MANUAL', 'RDT'));
        </sql>
        <!-- This constraint makes the manual/RDT shape rule structural rather than a
             code convention: it simultaneously allows an RDT row to omit result_value and stops a
             quantitative row from doing the same once the NOT NULL is dropped. Every
             existing reader of result_value assumes a value is present; this keeps that
             assumption true for the rows those readers can see. -->
        <sql>
            ALTER TABLE clinlims.qc_result
            ADD CONSTRAINT chk_qc_result_source_shape
            CHECK (
                (source = 'RDT' AND result_value IS NULL AND qualitative_outcome IS NOT NULL)
                OR
                (source &lt;&gt; 'RDT' AND result_value IS NOT NULL)
            );
        </sql>
        <rollback>
            <sql>ALTER TABLE clinlims.qc_result DROP CONSTRAINT chk_qc_result_source_shape;</sql>
            <sql>ALTER TABLE clinlims.qc_result DROP CONSTRAINT chk_qc_result_source;</sql>
        </rollback>
    </changeSet>

    <changeSet author="samuelmale" id="qc-023-relax-analyzer-and-value-not-nulls">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'chk_qc_result_source_shape'
            </sqlCheck>
        </preConditions>
        <comment>Manual/RDT controls have no analyzer, and RDT controls have no numeric value</comment>
        <!-- A bench run has no instrument. Analyzer rows continue to populate this and
             the FK to analyzer(id) from 008-add-instrument-fk-constraints.xml is
             unaffected — a nullable FK column simply skips the check when NULL. -->
        <dropNotNullConstraint schemaName="clinlims" tableName="qc_result"
            columnName="instrument_id" columnDataType="NUMERIC(10,0)"/>
        <!-- No synthetic numbers for qualitative outcomes. Guarded by
             chk_qc_result_source_shape above. -->
        <dropNotNullConstraint schemaName="clinlims" tableName="qc_result"
            columnName="result_value" columnDataType="numeric(15,5)"/>
        <!-- An RDT cassette lot is identified by control_label, not by a levelled
             control-material record, so a run can exist without a qc_control_lot row.
             Manual quantitative runs SHOULD carry one (that is where the fixed
             mean/SD lives) but the store must not require it. -->
        <dropNotNullConstraint schemaName="clinlims" tableName="qc_result"
            columnName="control_lot_id" columnDataType="varchar(36)"/>
    </changeSet>

    <!-- Target configuration adopts the existing Westgard control-lot lifecycle
         rather than a parallel lot store. That is impossible while
         qc_control_lot.instrument_id is NOT NULL with an FK to analyzer(id): a bench RDT
         kit lot has no instrument to point at, so today a manual control lot cannot be
         created at all — which would force exactly the parallel store we want to avoid. -->
    <changeSet author="samuelmale" id="qc-024-relax-control-lot-analyzer">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="clinlims" tableName="qc_control_lot"/>
        </preConditions>
        <comment>Bench control lots have no analyzer</comment>
        <dropNotNullConstraint schemaName="clinlims" tableName="qc_control_lot"
            columnName="instrument_id" columnDataType="NUMERIC(10,0)"/>
    </changeSet>

    <!-- A MANUAL Fail creates a real violation so it enters the same
         corrective-action workflow as an analyzer rule hit. qc_rule_violation.rule_code
         is an unconstrained VARCHAR(20), so MANUAL_FAIL inserts cleanly alongside the
         Unicode-subscript Westgard codes (1₃ₛ, 2₂ₛ, …); a violation raised off a bench
         run has no analyzer either. -->
    <changeSet author="samuelmale" id="qc-025-relax-violation-analyzer">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="clinlims" tableName="qc_rule_violation"/>
        </preConditions>
        <comment>Violations raised from manual controls have no analyzer</comment>
        <dropNotNullConstraint schemaName="clinlims" tableName="qc_rule_violation"
            columnName="instrument_id" columnDataType="NUMERIC(10,0)"/>
    </changeSet>

    <!-- Hold-or-warn is a lab policy, not a hard-coded behaviour. Off by default,
         so the signal starts as a visible warning on the validation row and a lab opts in
         to blocking release. A plain site flag rather than a qi_config indicator: the
         indicator table is CHECK-constrained to its enum and buys graded numeric
         thresholds, which a boolean signal has no use for. -->
    <changeSet author="samuelmale" id="qc-026-qc-fail-hold-flag">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.site_information WHERE name = 'qcFailBlocksValidation'
            </sqlCheck>
        </preConditions>
        <comment>Site flag: does an open QC failure block release of the results it covers</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id" valueSequenceNext="site_information_seq"/>
            <column name="name" value="qcFailBlocksValidation"/>
            <column name="lastupdated" valueComputed="${now}"/>
            <!-- description is varchar(120); the full explanation lives in the
                 instruction key, which is what the admin UI actually renders. -->
            <column name="description" value="Block release of results covered by an open QC failure"/>
            <column name="value" value="false"/>
            <column name="encrypted" value="false"/>
            <column name="domain_id"
                valueComputed="(SELECT id FROM site_information_domain WHERE name = 'resultConfiguration')"/>
            <column name="value_type" value="boolean"/>
            <column name="instruction_key" value="instructions.qc.fail.blocks.validation"/>
            <column name="group" value="0"/>
        </insert>
        <rollback>
            <delete schemaName="clinlims" tableName="site_information">
                <where>name = 'qcFailBlocksValidation'</where>
            </delete>
        </rollback>
    </changeSet>

    <!-- Nothing enforced control-lot uniqueness, for analyzer lots either. The rule
         is one live lot per (lot_number, test_id, control_level): the same physical
         lot number legitimately recurs across different tests, and EXPIRED lots must
         not block reuse of the number, hence a partial index rather than a plain
         unique constraint. QCControlLotValidator returns a friendly 400 for the same
         rule; this index makes raw SQL fail too. -->
    <changeSet author="samuelmale" id="qc-028-unique-active-control-lot">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_indexes
                WHERE schemaname = 'clinlims' AND indexname = 'uq_qc_control_lot_active'
            </sqlCheck>
        </preConditions>
        <comment>Partial unique index: one live lot per (lot_number, test_id, control_level)</comment>
        <sql>
            CREATE UNIQUE INDEX uq_qc_control_lot_active
            ON clinlims.qc_control_lot (lot_number, test_id, COALESCE(control_level, ''))
            WHERE status &lt;&gt; 'EXPIRED';
        </sql>
        <rollback>
            <sql>DROP INDEX clinlims.uq_qc_control_lot_active;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
