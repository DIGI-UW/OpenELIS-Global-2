<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

 <changeSet id="036-sample-item-container-type" author="openelisglobal">
  <preConditions onFail="MARK_RAN">
   <not>
    <columnExists schemaName="clinlims" tableName="sample_item" columnName="container_type_id"/>
   </not>
  </preConditions>
  <comment>OGC-1611 FR-B24 and G8: the container type a clinical sample was taken in, proposed from its tests' expected containers. Optional: a laboratory that does not track containers leaves it empty.</comment>
  <addColumn schemaName="clinlims" tableName="sample_item">
   <column name="container_type_id" type="BIGINT"/>
  </addColumn>
  <addForeignKeyConstraint constraintName="fk_sample_item_container_type" baseTableSchemaName="clinlims"
   baseTableName="sample_item" baseColumnNames="container_type_id" referencedTableSchemaName="clinlims"
   referencedTableName="container_type" referencedColumnNames="id"/>
  <createIndex schemaName="clinlims" tableName="sample_item" indexName="idx_sample_item_container_type">
   <column name="container_type_id"/>
  </createIndex>
  <rollback>
   <dropForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="sample_item"
    constraintName="fk_sample_item_container_type"/>
   <dropIndex schemaName="clinlims" tableName="sample_item" indexName="idx_sample_item_container_type"/>
   <dropColumn schemaName="clinlims" tableName="sample_item" columnName="container_type_id"/>
  </rollback>
 </changeSet>
</databaseChangeLog>
