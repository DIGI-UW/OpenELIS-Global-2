<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

  <!-- Add-ons: values of "secret" configuration fields (for example an API key
       the add-on's service needs), kept apart from the plain configuration and
       encrypted at rest with EncryptionConverter. Design: docs/addons/design.md -->

  <changeSet id="025-addon-secret-config" author="openelisglobal">
    <preConditions onFail="MARK_RAN">
      <tableExists schemaName="clinlims" tableName="addon"/>
      <not><columnExists schemaName="clinlims" tableName="addon" columnName="secret_config"/></not>
    </preConditions>
    <addColumn schemaName="clinlims" tableName="addon">
      <column name="secret_config" type="TEXT"/>
    </addColumn>
    <rollback>
      <dropColumn schemaName="clinlims" tableName="addon" columnName="secret_config"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
