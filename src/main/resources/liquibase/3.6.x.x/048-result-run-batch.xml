<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

 <changeSet id="OGC-1200-result-run-batch" author="openelisglobal">
  <preConditions onFail="MARK_RAN">
   <not>
    <columnExists schemaName="clinlims" tableName="result_run" columnName="batch_workplan_id"/>
   </not>
  </preConditions>
  <comment>OGC-1200 FR-B2, FR-G4: a released workplan batch is a run. The run names its batch and the reagent lot the batch runs on; the batch's analyses are the run's rows.</comment>
  <addColumn schemaName="clinlims" tableName="result_run">
   <column name="batch_workplan_id" type="bigint"/>
   <column name="reagent_lot_id" type="bigint"/>
  </addColumn>
  <addUniqueConstraint schemaName="clinlims" tableName="result_run" columnNames="batch_workplan_id"
   constraintName="result_run_batch_workplan_uk"/>
  <addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="result_run" baseColumnNames="batch_workplan_id"
   constraintName="result_run_batch_workplan_fk" referencedTableSchemaName="clinlims" referencedTableName="batch_workplan"
   referencedColumnNames="id" onDelete="SET NULL"/>
 </changeSet>
</databaseChangeLog>
