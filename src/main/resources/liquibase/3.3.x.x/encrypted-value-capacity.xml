<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
    <!-- Shared schema preparation for normal installs and the explicit key upgrade. -->
    <changeSet id="installation-encryption-capacity-delivery_channel" author="openelis">
        <!-- An older schema may not have this feature yet; retry after it is installed. -->
        <preConditions onFail="CONTINUE">
            <columnExists schemaName="clinlims" tableName="delivery_channel" columnName="secret"/>
        </preConditions>
        <modifyDataType schemaName="clinlims" tableName="delivery_channel" columnName="secret" newDataType="TEXT"/>
        <rollback>
            <modifyDataType schemaName="clinlims" tableName="delivery_channel" columnName="secret" newDataType="VARCHAR(2048)"/>
        </rollback>
    </changeSet>
    <changeSet id="installation-encryption-capacity-eqa_panel_sample" author="openelis">
        <!-- An older schema may not have this feature yet; retry after it is installed. -->
        <preConditions onFail="CONTINUE">
            <columnExists schemaName="clinlims" tableName="eqa_panel_sample" columnName="target_value"/>
        </preConditions>
        <modifyDataType schemaName="clinlims" tableName="eqa_panel_sample" columnName="target_value" newDataType="TEXT"/>
        <rollback>
            <modifyDataType schemaName="clinlims" tableName="eqa_panel_sample" columnName="target_value" newDataType="VARCHAR(512)"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
