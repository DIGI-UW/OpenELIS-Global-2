<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="storage-037-add-last-updated-to-print-history" author="vishalmore90">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="storage_location_print_history" columnName="last_updated"/>
            </not>
        </preConditions>
        <comment>Add last_updated column to storage_location_print_history table for BaseObject optimistic locking</comment>
        <addColumn tableName="storage_location_print_history">
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="storage_location_print_history" columnName="last_updated"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
