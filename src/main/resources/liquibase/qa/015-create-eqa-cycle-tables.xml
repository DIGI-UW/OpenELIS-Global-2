<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    OGC-609 [EQA V2.1 / T-08] Schema spine 1 of 2: cycle, round, cycle-state
    audit (FR-V2.1-01/02/21).

    Conventions follow the V1 EQA DDL (3.3.x.x/eqa-001..011), NOT qa/013's
    audited-entity style, because these entities extend the eqa module's
    BaseObject pattern:
      * numeric(10,0) PK + <table>_seq sequence (matches @SequenceGenerator).
      * sys_user_id VARCHAR(36) NOT NULL + last_updated (@Version) columns.
      * No reference_tables registration — the eqa module is not opted into
        the generic audit trail; cycle history has its own dedicated audit
        table (eqa_cycle_state_transition) per FR-V2.1-21.

    eqa_cycle.status holds BOTH state machines (participant FR-V2.1-04 and
    provider FR-V2.1-18) — which enum applies depends on whether this lab is
    the scheme's provider. The CHECK is the union; transition legality is
    enforced at the service layer (T-10), not here.

    scheme_id references eqa_program: gate G1 (2026-08-13) kept the V1 table
    name and made "scheme" the domain word — new columns use the domain word.

    Enum values are stored UPPERCASE (Java @Enumerated(STRING) names, matching
    the V1 'DRAFT' precedent); FRS lowercase spellings are spec labels only.
    -->

    <changeSet author="openelisglobal" id="eqa-cycle-001-create-eqa-cycle">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="eqa_cycle" schemaName="clinlims"/></not>
        </preConditions>
        <comment>EQA cycle: one run of a scheme (FR-V2.1-01)</comment>
        <createSequence sequenceName="eqa_cycle_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <createTable schemaName="clinlims" tableName="eqa_cycle">
            <column name="id" type="numeric(10,0)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_eqa_cycle"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_eqa_cycle_fhir_uuid"/>
            </column>
            <column name="scheme_id" type="numeric(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="cycle_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="cycle_name" type="VARCHAR(255)"/>
            <column name="planned_start_date" type="DATE"/>
            <column name="planned_end_date" type="DATE"/>
            <column name="actual_start_date" type="DATE"/>
            <column name="actual_end_date" type="DATE"/>
            <column name="status" type="VARCHAR(30)" defaultValue="PLANNED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="numeric(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="sys_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            schemaName="clinlims" tableName="eqa_cycle"
            columnNames="scheme_id, cycle_number"
            constraintName="uq_eqa_cycle_scheme_number"/>

        <addForeignKeyConstraint
            constraintName="fk_eqa_cycle_eqa_program"
            baseTableSchemaName="clinlims" baseTableName="eqa_cycle" baseColumnNames="scheme_id"
            referencedTableSchemaName="clinlims" referencedTableName="eqa_program" referencedColumnNames="id"/>

        <addForeignKeyConstraint
            constraintName="fk_eqa_cycle_system_user"
            baseTableSchemaName="clinlims" baseTableName="eqa_cycle" baseColumnNames="created_by"
            referencedTableSchemaName="clinlims" referencedTableName="system_user" referencedColumnNames="id"/>

        <!-- Union of participant (FR-V2.1-04) and provider (FR-V2.1-18) machines. -->
        <sql>
            ALTER TABLE clinlims.eqa_cycle
            ADD CONSTRAINT eqa_cycle_status_chk
            CHECK (status IN ('PLANNED', 'PANEL_RECEIVED', 'TESTING', 'READY_TO_SUBMIT', 'SUBMITTED',
                'PREP_IN_PROGRESS', 'READY_TO_SHIP', 'SHIPPED', 'DELIVERED', 'SUBMISSIONS_OPEN',
                'SUBMISSIONS_CLOSED', 'SCORING', 'SCORED', 'CLOSED'))
        </sql>

        <rollback>
            <dropTable schemaName="clinlims" tableName="eqa_cycle"/>
            <dropSequence sequenceName="eqa_cycle_seq" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet author="openelisglobal" id="eqa-cycle-002-create-eqa-round">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="eqa_round" schemaName="clinlims"/></not>
        </preConditions>
        <comment>EQA round: one distribution event within a cycle (FR-V2.1-02)</comment>
        <createSequence sequenceName="eqa_round_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <createTable schemaName="clinlims" tableName="eqa_round">
            <column name="id" type="numeric(10,0)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_eqa_round"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_eqa_round_fhir_uuid"/>
            </column>
            <column name="cycle_id" type="numeric(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="round_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="distribution_date" type="TIMESTAMP"/>
            <column name="submission_deadline" type="TIMESTAMP"/>
            <column name="sample_count" type="INT"/>
            <!-- No CHECK: the FRS never enumerates round status; plain String
                 in Java too (EQAProgramEnrollment.status precedent). -->
            <column name="status" type="VARCHAR(30)"/>
            <column name="sys_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            schemaName="clinlims" tableName="eqa_round"
            columnNames="cycle_id, round_number"
            constraintName="uq_eqa_round_cycle_number"/>

        <!-- Default RESTRICT: a cycle with rounds cannot be hard-deleted. -->
        <addForeignKeyConstraint
            constraintName="fk_eqa_round_eqa_cycle"
            baseTableSchemaName="clinlims" baseTableName="eqa_round" baseColumnNames="cycle_id"
            referencedTableSchemaName="clinlims" referencedTableName="eqa_cycle" referencedColumnNames="id"/>

        <rollback>
            <dropTable schemaName="clinlims" tableName="eqa_round"/>
            <dropSequence sequenceName="eqa_round_seq" schemaName="clinlims"/>
        </rollback>
    </changeSet>

    <changeSet author="openelisglobal" id="eqa-cycle-003-create-eqa-cycle-state-transition">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="eqa_cycle_state_transition" schemaName="clinlims"/></not>
        </preConditions>
        <comment>Immutable cycle-state audit: who/what/why per transition (FR-V2.1-21)</comment>
        <createSequence sequenceName="eqa_cycle_state_transition_seq" schemaName="clinlims" startValue="1" incrementBy="1"/>
        <createTable schemaName="clinlims" tableName="eqa_cycle_state_transition">
            <column name="id" type="numeric(10,0)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_eqa_cycle_state_transition"/>
            </column>
            <column name="cycle_id" type="numeric(10,0)">
                <constraints nullable="false"/>
            </column>
            <!-- TEXT, not enum: this table records BOTH state machines, whose
                 enums differ (FR-V2.1-21). NULL prior_state = cycle creation. -->
            <column name="prior_state" type="TEXT"/>
            <column name="new_state" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="state_machine" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_event" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <!-- Populated when trigger_type = MANUAL, NULL for AUTO. -->
            <column name="triggered_by" type="numeric(10,0)"/>
            <!-- Required at API layer for off-happy-path manual transitions. -->
            <column name="reason" type="TEXT"/>
            <column name="occurred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="sys_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_eqa_cycle_state_transition_eqa_cycle"
            baseTableSchemaName="clinlims" baseTableName="eqa_cycle_state_transition" baseColumnNames="cycle_id"
            referencedTableSchemaName="clinlims" referencedTableName="eqa_cycle" referencedColumnNames="id"/>

        <addForeignKeyConstraint
            constraintName="fk_eqa_cycle_state_transition_system_user"
            baseTableSchemaName="clinlims" baseTableName="eqa_cycle_state_transition" baseColumnNames="triggered_by"
            referencedTableSchemaName="clinlims" referencedTableName="system_user" referencedColumnNames="id"/>

        <sql>
            ALTER TABLE clinlims.eqa_cycle_state_transition
            ADD CONSTRAINT eqa_cycle_state_transition_machine_chk
            CHECK (state_machine IN ('PARTICIPANT', 'PROVIDER'))
        </sql>

        <sql>
            ALTER TABLE clinlims.eqa_cycle_state_transition
            ADD CONSTRAINT eqa_cycle_state_transition_trigger_type_chk
            CHECK (trigger_type IN ('AUTO', 'MANUAL'))
        </sql>

        <sql>
            ALTER TABLE clinlims.eqa_cycle_state_transition
            ADD CONSTRAINT eqa_cycle_state_transition_trigger_event_chk
            CHECK (trigger_event IN ('LAST_VALIDATED_RESULT', 'FHIR_SUBMIT_SUCCESS', 'FHIR_SUBMIT_FAILURE_RETRY',
                'SCORE_INTAKE', 'DEADLINE_TIMER', 'ALL_SHIPMENTS_DELIVERED', 'ALL_SUBMISSIONS_RECEIVED',
                'PANEL_SEAL', 'PANEL_UNBLIND', 'HOMOGENEITY_QC_PASSED', 'MANUAL_OVERRIDE', 'SCHEDULED_JOB'))
        </sql>

        <!-- Timeline queries (V2.5 FR-V2.5-16 cycle-timeline Accordion). -->
        <createIndex schemaName="clinlims" tableName="eqa_cycle_state_transition"
            indexName="idx_eqa_cycle_state_transition_cycle_occurred">
            <column name="cycle_id"/>
            <column name="occurred_at"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="clinlims" tableName="eqa_cycle_state_transition"/>
            <dropSequence sequenceName="eqa_cycle_state_transition_seq" schemaName="clinlims"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
