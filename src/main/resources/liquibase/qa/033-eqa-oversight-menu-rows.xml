<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    OGC-611 — switch the oversight menu rows back on as their pages ship.

    qa/019 seeded these rows at the FRS paths before any page existed and qa/029
    deactivated them for exactly that reason, leaving each card to re-activate its
    own row at the route its page actually serves. This is that re-activation for
    the Follow-Up Queue (FR-V2.3-02); Lab Performance and Analyst Competency stay
    hidden until their pages land.
    -->

    <changeSet author="openelisglobal" id="qa-062-activate-menu-eqa-follow-up-queue">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM clinlims.menu WHERE element_id = 'menu_eqa_follow_up_queue'
            </sqlCheck>
        </preConditions>
        <comment>Follow-Up Queue menu row: point at /qa/eqa/follow-up-queue and switch it on</comment>

        <update tableName="menu" schemaName="clinlims">
            <column name="action_url" value="/qa/eqa/follow-up-queue" />
            <column name="is_active" valueBoolean="true" />
            <where>element_id = 'menu_eqa_follow_up_queue'</where>
        </update>

        <rollback>
            <update tableName="menu" schemaName="clinlims">
                <column name="action_url" value="/eqa/oversight/follow-up-queue" />
                <column name="is_active" valueBoolean="false" />
                <where>element_id = 'menu_eqa_follow_up_queue'</where>
            </update>
        </rollback>
    </changeSet>

</databaseChangeLog>
