<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- QA Phase C — OGC-707: CAPA Register.
         Adds the cross-NCE CAPA register page under the QMS & Improvement pillar.
         REST access is enforced by @PreAuthorize on the existing qa.view.qms
         authority (liquibase/qa/004); no new system_module rows are needed. -->

    <changeSet author="openelisglobal" id="qa-029-add-menu-qa-qms-capa-register">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.menu WHERE element_id = 'menu_qa_qms_capa_register'
            </sqlCheck>
        </preConditions>
        <comment>Adds CAPA Register under QMS &amp; Improvement</comment>
        <insert tableName="menu" schemaName="clinlims">
            <column name="id" valueSequenceNext="menu_seq" />
            <column name="parent_id" valueComputed="(SELECT id FROM clinlims.menu WHERE element_id = 'menu_qa_qms')" />
            <column name="presentation_order" value="40" />
            <column name="element_id" value="menu_qa_qms_capa_register" />
            <column name="action_url" value="/qa/qms/capa-register" />
            <column name="display_key" value="sideNav.label.qa.qms.capaRegister" />
            <column name="tool_tip_key" value="sideNav.label.qa.qms.capaRegister" />
            <column name="new_window" valueBoolean="false" />
            <column name="is_active" valueBoolean="true" />
            <column name="hide_in_old_ui" valueBoolean="true" />
        </insert>
    </changeSet>

</databaseChangeLog>
