<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    OGC-714 Critical Callback capture. One row documents one manual phone-callback
    attempt for a critical result (TJC NPSG.02.03.01 / CLSI GP47 read-back); the
    call itself is manual, this table only records that it happened, and repeat
    attempts for the same result are new rows. Rows are write-once and are
    themselves the record, so the table is not registered for generic audit history
    and can use a UUID id. Criticality is never persisted here - it is derived from
    the result_limits critical bounds. A later read-back form or polymorphic
    critical notification (OGC-785/886) should extend this table rather than add a
    parallel store.
    -->

    <changeSet author="openelisglobal" id="critical-callback-001-create-table">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="critical_callback" schemaName="clinlims"/></not>
        </preConditions>
        <createTable schemaName="clinlims" tableName="critical_callback">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_critical_callback"/>
            </column>
            <column name="result_id" type="numeric(10)">
                <constraints nullable="false"/>
            </column>
            <column name="analysis_id" type="numeric(10)">
                <constraints nullable="false"/>
            </column>
            <!-- value as communicated on the call; server-side copy of result.value at log time -->
            <column name="result_value" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <!-- sys_user.id of the caller; stamped server-side, never client-supplied -->
            <column name="logged_by" type="numeric(10)">
                <constraints nullable="false"/>
            </column>
            <column name="logged_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <!-- DB-filled wall-clock last-modified (not mapped in the entity) -->
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <!-- BaseObject @Version optimistic-lock column (distinct from lastupdated) -->
            <column name="last_updated" type="TIMESTAMP"/>
        </createTable>

        <sql>
            ALTER TABLE clinlims.critical_callback
            ADD CONSTRAINT critical_callback_status_chk
            CHECK (status IN ('CONFIRMED', 'REACHED_NO_READBACK', 'UNABLE_TO_REACH'))
        </sql>

        <addForeignKeyConstraint
            constraintName="fk_critical_callback_result"
            baseTableSchemaName="clinlims" baseTableName="critical_callback" baseColumnNames="result_id"
            referencedTableSchemaName="clinlims" referencedTableName="result" referencedColumnNames="id"/>

        <addForeignKeyConstraint
            constraintName="fk_critical_callback_analysis"
            baseTableSchemaName="clinlims" baseTableName="critical_callback" baseColumnNames="analysis_id"
            referencedTableSchemaName="clinlims" referencedTableName="analysis" referencedColumnNames="id"/>

        <!-- The compliance numerator joins on analysis_id -->
        <createIndex schemaName="clinlims" tableName="critical_callback" indexName="idx_critical_callback_analysis">
            <column name="analysis_id"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="clinlims" tableName="critical_callback"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
