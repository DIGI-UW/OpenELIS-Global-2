<?xml version="1.0" encoding="UTF-8"?>
<!--
    EQA V2.1 (OGC-609): the optional cycle-review gate flag.
    Off by default, so existing schemes keep auto-submitting.
    When on, the participant cycle halts at ready_to_submit until a QA officer
    confirms on the Review & Submit panel and the
    auto-submit stands down.

    The schema spine added scheme_type to eqa_program and stopped there, while
    both My Cycles and the auto-submit sweep read the flag.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet author="openelisglobal" id="qa-046-add-eqa-program-requires-cycle-review">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="eqa_program" columnName="requires_cycle_review" schemaName="clinlims"/>
            </not>
        </preConditions>
        <comment>Optional cycle-review gate per scheme; existing rows default to off</comment>
        <addColumn schemaName="clinlims" tableName="eqa_program">
            <column name="requires_cycle_review" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="eqa_program" columnName="requires_cycle_review"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
