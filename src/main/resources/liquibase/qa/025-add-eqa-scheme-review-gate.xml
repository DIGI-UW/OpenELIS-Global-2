<?xml version="1.0" encoding="UTF-8"?>
<!--
    EQA V2.1 (OGC-609) FR-V2.1-09: the optional cycle-review gate flag.
    Off by default, so existing schemes keep auto-submitting (FR-V2.2-05).
    When on, the participant cycle halts at ready_to_submit until a QA officer
    confirms on the Review & Submit panel (FR-V2.2-07, T-13) and T-14's
    auto-submit stands down.

    No task card owned this column: T-08 added scheme_type to eqa_program and
    stopped there, while T-13 and T-14 both read the flag.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet author="openelisglobal" id="qa-046-add-eqa-program-requires-cycle-review">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="eqa_program" columnName="requires_cycle_review" schemaName="clinlims"/>
            </not>
        </preConditions>
        <comment>Optional cycle-review gate per scheme; existing rows default to off (FR-V2.1-09)</comment>
        <addColumn schemaName="clinlims" tableName="eqa_program">
            <column name="requires_cycle_review" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="eqa_program" columnName="requires_cycle_review"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
