<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd"
    logicalFilePath="inventory/inventory-item-ordering-state.xml">

    <!-- OGC-438: per-item ordering state, so an ordered item stops alerting -->
    <changeSet id="OGC-438-add-ordering-state-to-inventory-item" author="OGC">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="inventory_item" columnName="ordered_at" schemaName="clinlims"/>
            </not>
        </preConditions>

        <addColumn tableName="inventory_item" schemaName="clinlims">
            <column name="ordered_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="order_note" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="order_expected_date" type="DATE">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="inventory_item" columnName="ordered_at" schemaName="clinlims"/>
            <dropColumn tableName="inventory_item" columnName="order_note" schemaName="clinlims"/>
            <dropColumn tableName="inventory_item" columnName="order_expected_date" schemaName="clinlims"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
