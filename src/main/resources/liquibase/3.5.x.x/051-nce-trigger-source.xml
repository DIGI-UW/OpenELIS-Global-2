<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ================================================================== -->
    <!-- WS-2 (OGC-701 / OGC-728): Westgard QC violation -> auto-created NCE -->
    <!-- Persists NcEvent's trigger-source provenance fields and the        -->
    <!-- affected-samples cap reason.                                       -->
    <!-- ================================================================== -->

    <changeSet author="samuelmale" id="nce-trigger-001-add-nc-event-trigger-source">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="clinlims" tableName="nc_event"/>
            <not>
                <columnExists schemaName="clinlims" tableName="nc_event" columnName="trigger_source_type"/>
            </not>
        </preConditions>
        <comment>Add trigger-source provenance and affected-samples cap columns to nc_event</comment>

        <addColumn schemaName="clinlims" tableName="nc_event">
            <column name="trigger_source_type" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="trigger_source_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
            <column name="auto_generated" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
            <column name="westgard_rule" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="affected_samples_cap_reason" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="samuelmale" id="nce-trigger-002-unique-trigger-source">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="clinlims" tableName="nc_event"/>
            <columnExists schemaName="clinlims" tableName="nc_event" columnName="trigger_source_id"/>
            <not>
                <indexExists schemaName="clinlims" indexName="uq_nc_event_trigger_source"/>
            </not>
        </preConditions>
        <comment>One NCE per trigger source (idempotent auto-creation). PostgreSQL treats
            NULLs as distinct, so manually created NCEs (NULL trigger source) never collide.</comment>

        <addUniqueConstraint
            schemaName="clinlims"
            tableName="nc_event"
            columnNames="trigger_source_type, trigger_source_id"
            constraintName="uq_nc_event_trigger_source"/>
    </changeSet>

</databaseChangeLog>
