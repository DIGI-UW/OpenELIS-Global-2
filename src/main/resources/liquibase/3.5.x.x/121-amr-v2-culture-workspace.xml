<column name="recorded_at" type="timestamp"><constraints nullable="false"/></column>
<column name="lastupdated" type="timestamp" defaultValueComputed="now()"><constraints nullable="false"/></column>
<column name="last_updated" type="timestamp"><constraints nullable="true"/></column>
<column name="reading_id" type="numeric(10)"><constraints nullable="true"/></column>
<column name="quantity_id" type="numeric(10)"><constraints nullable="true"/></column>
<column name="note" type="varchar(2000)"><constraints nullable="true"/></column>
<column name="incubation_day" type="numeric(10,2)"><constraints nullable="true"/></column>
</createTable>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_culture_reading" baseColumnNames="inoculation_id" referencedTableSchemaName="clinlims" referencedTableName="micro_case_inoculation" referencedColumnNames="id" constraintName="fk_micro_culture_reading_row"/>
<createIndex schemaName="clinlims" tableName="micro_culture_reading" indexName="idx_micro_culture_reading_row"><column name="inoculation_id"/></createIndex>
<createTable schemaName="clinlims" tableName="micro_culture_extension">
<column name="id" type="varchar(36)"><constraints nullable="false" primaryKey="true"/></column>
