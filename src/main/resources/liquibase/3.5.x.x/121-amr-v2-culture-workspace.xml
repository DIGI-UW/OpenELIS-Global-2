<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_case_inoculation" baseColumnNames="source_sample_item_id" referencedTableSchemaName="clinlims" referencedTableName="sample_item" referencedColumnNames="id" constraintName="fk_m4_source_sample_item_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_case_analysis" baseColumnNames="culture_id" referencedTableSchemaName="clinlims" referencedTableName="micro_case_inoculation" referencedColumnNames="id" constraintName="fk_m4_culture_id"/>
