</createTable>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_culture_extension" baseColumnNames="inoculation_id" referencedTableSchemaName="clinlims" referencedTableName="micro_case_inoculation" referencedColumnNames="id" constraintName="fk_micro_culture_extension_row"/>
