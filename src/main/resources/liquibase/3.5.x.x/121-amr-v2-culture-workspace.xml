<column name="recorded_by" type="varchar(20)"><constraints nullable="false"/></column>
<column name="recorded_at" type="timestamp"><constraints nullable="false"/></column>
<column name="lastupdated" type="timestamp" defaultValueComputed="now()"><constraints nullable="false"/></column>
<column name="last_updated" type="timestamp"><constraints nullable="true"/></column>
<column name="signal" type="varchar(1000)"><constraints nullable="true"/></column>
<column name="confirmed_by" type="varchar(20)"><constraints nullable="true"/></column>
<column name="confirmed_at" type="timestamp"><constraints nullable="true"/></column>
</createTable>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_culture_proposal" baseColumnNames="inoculation_id" referencedTableSchemaName="clinlims" referencedTableName="micro_case_inoculation" referencedColumnNames="id" constraintName="fk_micro_culture_proposal_row"/>
