</addColumn>
<addColumn schemaName="clinlims" tableName="micro_case_analysis">
<column name="culture_id" type="varchar(36)"/>
</addColumn>
<createTable schemaName="clinlims" tableName="micro_culture_reading">
<column name="id" type="varchar(36)"><constraints nullable="false" primaryKey="true"/></column>
<column name="inoculation_id" type="varchar(36)"><constraints nullable="false"/></column>
