<column name="subculture_purpose" type="varchar(40)"/>
<column name="medium_item_id" type="bigint"/>
<column name="lot_id" type="bigint"/>
<column name="not_tracked" type="boolean" defaultValueBoolean="false"/>
<column name="temperature" type="numeric(6,2)"/>
<column name="duration" type="numeric(10,2)"/>
<column name="duration_unit" type="varchar(10)"/>
<column name="check_interval_hours" type="numeric(10,2)"/>
<column name="loop_volume" type="numeric(10,2)"/>
<column name="positive_at" type="timestamp"/>
