<column name="sample_type_id" type="numeric(10)"/>
<column name="culture_duration" type="numeric(10,2)"/>
<column name="culture_duration_unit" type="varchar(10)"/>
<column name="culture_check_interval_hours" type="numeric(10,2)"/>
<column name="culture_loop_volume" type="numeric(10,2)"/>
