<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="OGC-1054-analyzer-profile-binding" author="OGC">
        <createSequence schemaName="clinlims" sequenceName="analyzer_profile_binding_seq"
            startValue="1" incrementBy="1"/>
        <createTable schemaName="clinlims" tableName="analyzer_profile_binding">
            <column name="id" type="numeric(10)">
                <constraints primaryKey="true" nullable="false"
                    primaryKeyName="pk_analyzer_profile_binding"/>
            </column>
            <column name="profile_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="profile_revision" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="profile_fingerprint" type="VARCHAR(71)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint schemaName="clinlims" tableName="analyzer_profile_binding"
            columnNames="profile_id, profile_revision"
            constraintName="uq_analyzer_profile_binding_revision"/>
        <sql>
            ALTER TABLE clinlims.analyzer_profile_binding
            ADD CONSTRAINT chk_analyzer_profile_binding_revision
            CHECK (profile_revision &gt;= 1);
        </sql>
        <addColumn schemaName="clinlims" tableName="analyzer">
            <column name="profile_binding_id" type="numeric(10)"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_analyzer_profile_binding"
            baseTableSchemaName="clinlims" baseTableName="analyzer" baseColumnNames="profile_binding_id"
            referencedTableSchemaName="clinlims" referencedTableName="analyzer_profile_binding"
            referencedColumnNames="id"/>
        <createIndex schemaName="clinlims" tableName="analyzer" indexName="idx_analyzer_profile_binding">
            <column name="profile_binding_id"/>
        </createIndex>
        <rollback>
            <dropForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="analyzer"
                constraintName="fk_analyzer_profile_binding"/>
            <dropColumn schemaName="clinlims" tableName="analyzer" columnName="profile_binding_id"/>
            <dropTable schemaName="clinlims" tableName="analyzer_profile_binding"/>
            <dropSequence schemaName="clinlims" sequenceName="analyzer_profile_binding_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
