<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
<changeSet id="amr-v2-m6-ast-reporting" author="openelis">
<createTable schemaName="clinlims" tableName="micro_ast_panel_assignment"><column name="id" type="varchar(36)"><constraints primaryKey="true" nullable="false"/></column><column name="isolate_id" type="varchar(36)"><constraints nullable="false"/></column><column name="panel_id" type="varchar(36)"><constraints nullable="false"/></column><column name="panel_family" type="varchar(36)"><constraints nullable="false"/></column><column name="provenance" type="varchar(20)"><constraints nullable="false"/></column><column name="assigned_by" type="varchar(20)"><constraints nullable="false"/></column><column name="assigned_at" type="timestamp"><constraints nullable="false"/></column><column name="retired_at" type="timestamp"></column><column name="last_updated" type="timestamp"/></createTable>
<createTable schemaName="clinlims" tableName="micro_ast_report_choice"><column name="id" type="varchar(36)"><constraints primaryKey="true" nullable="false"/></column><column name="isolate_id" type="varchar(36)"><constraints nullable="false"/></column><column name="antibiotic_id" type="varchar(36)"><constraints nullable="false"/></column><column name="reading_id" type="varchar(36)"><constraints nullable="false"/></column><column name="selected_by" type="varchar(20)"><constraints nullable="false"/></column><column name="selected_at" type="timestamp"><constraints nullable="false"/></column><column name="last_updated" type="timestamp"/></createTable>
<createTable schemaName="clinlims" tableName="micro_molecular_dst_binding"><column name="id" type="varchar(36)"><constraints primaryKey="true" nullable="false"/></column><column name="test_id" type="varchar(20)"><constraints nullable="false"/></column><column name="component_id" type="varchar(36)"><constraints nullable="false"/></column><column name="antibiotic_id" type="varchar(36)"><constraints nullable="false"/></column><column name="susceptible_value" type="varchar(200)"><constraints nullable="false"/></column><column name="resistant_value" type="varchar(200)"><constraints nullable="false"/></column><column name="last_updated" type="timestamp"/></createTable>
<createTable schemaName="clinlims" tableName="micro_dst_resolution"><column name="id" type="varchar(36)"><constraints primaryKey="true" nullable="false"/></column><column name="case_id" type="varchar(36)"><constraints nullable="false"/></column><column name="antibiotic_id" type="varchar(36)"><constraints nullable="false"/></column><column name="evidence_fingerprint" type="varchar(64)"><constraints nullable="false"/></column><column name="interpretation" type="varchar(40)"><constraints nullable="false"/></column><column name="reason" type="text"><constraints nullable="false"/></column><column name="resolved_by" type="varchar(20)"><constraints nullable="false"/></column><column name="resolved_at" type="timestamp"><constraints nullable="false"/></column><column name="last_updated" type="timestamp"/></createTable>
<addUniqueConstraint schemaName="clinlims" tableName="micro_ast_report_choice" columnNames="isolate_id,antibiotic_id" constraintName="uq_micro_ast_choice_agent"/>
<addUniqueConstraint schemaName="clinlims" tableName="micro_molecular_dst_binding" columnNames="test_id,component_id,antibiotic_id" constraintName="uq_micro_molecular_binding"/>
<sql>CREATE UNIQUE INDEX uq_micro_ast_assignment_family ON clinlims.micro_ast_panel_assignment (isolate_id, panel_family) WHERE retired_at IS NULL;</sql>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_ast_panel_assignment" baseColumnNames="isolate_id" referencedTableSchemaName="clinlims" referencedTableName="micro_isolate" referencedColumnNames="id" constraintName="fk_micro_ast_panel_assignment_isolate_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_ast_panel_assignment" baseColumnNames="panel_id" referencedTableSchemaName="clinlims" referencedTableName="micro_ast_panel" referencedColumnNames="id" constraintName="fk_micro_ast_panel_assignment_panel_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_ast_report_choice" baseColumnNames="isolate_id" referencedTableSchemaName="clinlims" referencedTableName="micro_isolate" referencedColumnNames="id" constraintName="fk_micro_ast_report_choice_isolate_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_ast_report_choice" baseColumnNames="antibiotic_id" referencedTableSchemaName="clinlims" referencedTableName="micro_antibiotic" referencedColumnNames="id" constraintName="fk_micro_ast_report_choice_antibiotic_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_ast_report_choice" baseColumnNames="reading_id" referencedTableSchemaName="clinlims" referencedTableName="micro_ast_reading" referencedColumnNames="id" constraintName="fk_micro_ast_report_choice_reading_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_molecular_dst_binding" baseColumnNames="antibiotic_id" referencedTableSchemaName="clinlims" referencedTableName="micro_antibiotic" referencedColumnNames="id" constraintName="fk_micro_molecular_dst_binding_antibiotic_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_dst_resolution" baseColumnNames="case_id" referencedTableSchemaName="clinlims" referencedTableName="micro_case" referencedColumnNames="id" constraintName="fk_micro_dst_resolution_case_id"/>
<addForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="micro_dst_resolution" baseColumnNames="antibiotic_id" referencedTableSchemaName="clinlims" referencedTableName="micro_antibiotic" referencedColumnNames="id" constraintName="fk_micro_dst_resolution_antibiotic_id"/>
<addColumn schemaName="clinlims" tableName="micro_organism"><column name="susceptibility_protocol" type="varchar(24)" defaultValue="GENERAL"><constraints nullable="false"/></column></addColumn>
<addColumn schemaName="clinlims" tableName="micro_ast_panel"><column name="susceptibility_protocol" type="varchar(24)" defaultValue="GENERAL"><constraints nullable="false"/></column></addColumn>
<addColumn schemaName="clinlims" tableName="micro_antibiotic"><column name="resistance_role" type="varchar(32)" defaultValue="NONE"><constraints nullable="false"/></column></addColumn>
<addColumn schemaName="clinlims" tableName="micro_case_analysis"><column name="selected_for_report" type="boolean"/></addColumn>
<addColumn schemaName="clinlims" tableName="micro_report_version"><column name="structured_content" type="text"/></addColumn>
<sql>ALTER TABLE clinlims.micro_report_version DROP CONSTRAINT micro_report_version_type_chk;
ALTER TABLE clinlims.micro_report_version ADD CONSTRAINT micro_report_version_type_chk CHECK (release_type IN ('PRELIMINARY','FINAL','AMENDED'));</sql>
<addColumn schemaName="clinlims" tableName="micro_ast_reading"><column name="entry_sequence" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column></addColumn>
<sql>WITH revisions AS (SELECT id, row_number() OVER (PARTITION BY ast_run_id ORDER BY created_at, id) AS sequence FROM clinlims.micro_ast_reading) UPDATE clinlims.micro_ast_reading r SET entry_sequence = revisions.sequence FROM revisions WHERE r.id = revisions.id;</sql>
<addUniqueConstraint schemaName="clinlims" tableName="micro_ast_reading" columnNames="ast_run_id,entry_sequence" constraintName="uq_micro_ast_reading_sequence"/>
<dropIndex schemaName="clinlims" tableName="micro_ast_run" indexName="uq_micro_ast_run_reportable"/>
<!-- Preserve previously reviewed, selected clinical readings when replacing run-wide selection. -->
<sql>INSERT INTO clinlims.micro_ast_report_choice (id,isolate_id,antibiotic_id,reading_id,selected_by,selected_at,last_updated)
SELECT id,isolate_id,antibiotic_id,id,reviewed_by,reviewed_at,CURRENT_TIMESTAMP FROM (
SELECT r.id,a.isolate_id,r.antibiotic_id,a.reviewed_by,a.reviewed_at,
row_number() OVER (PARTITION BY a.isolate_id,r.antibiotic_id ORDER BY a.reviewed_at DESC,a.id DESC,r.entry_sequence DESC) AS choice_order
FROM clinlims.micro_ast_reading r JOIN clinlims.micro_ast_run a ON a.id=r.ast_run_id
JOIN clinlims.micro_isolate i ON i.id=a.isolate_id
WHERE a.reportable=true AND a.status='REVIEWED' AND a.reviewed_by IS NOT NULL AND a.reviewed_at IS NOT NULL AND i.cancelled_at IS NULL
) selected WHERE choice_order=1;</sql>
<rollback><sql splitStatements="false">DO $$ BEGIN IF EXISTS (SELECT 1 FROM clinlims.micro_report_version WHERE structured_content IS NOT NULL OR release_type = 'PRELIMINARY') OR EXISTS (SELECT 1 FROM clinlims.micro_case_analysis WHERE selected_for_report IS NOT NULL) OR EXISTS (SELECT 1 FROM clinlims.micro_ast_panel_assignment) OR EXISTS (SELECT 1 FROM clinlims.micro_ast_report_choice) OR EXISTS (SELECT 1 FROM clinlims.micro_molecular_dst_binding) OR EXISTS (SELECT 1 FROM clinlims.micro_dst_resolution) OR EXISTS (SELECT 1 FROM clinlims.micro_organism WHERE susceptibility_protocol &lt;&gt; 'GENERAL') OR EXISTS (SELECT 1 FROM clinlims.micro_ast_panel WHERE susceptibility_protocol &lt;&gt; 'GENERAL') OR EXISTS (SELECT 1 FROM clinlims.micro_antibiotic WHERE resistance_role &lt;&gt; 'NONE') THEN RAISE EXCEPTION 'M6 rollback would discard history or configuration; export and retain it before rollback'; END IF; END $$;</sql><dropColumn schemaName="clinlims" tableName="micro_organism" columnName="susceptibility_protocol"/><dropColumn schemaName="clinlims" tableName="micro_ast_panel" columnName="susceptibility_protocol"/><dropColumn schemaName="clinlims" tableName="micro_antibiotic" columnName="resistance_role"/><dropTable schemaName="clinlims" tableName="micro_dst_resolution"/><dropTable schemaName="clinlims" tableName="micro_molecular_dst_binding"/><dropTable schemaName="clinlims" tableName="micro_ast_report_choice"/><dropTable schemaName="clinlims" tableName="micro_ast_panel_assignment"/><sql>ALTER TABLE clinlims.micro_report_version DROP CONSTRAINT micro_report_version_type_chk;
ALTER TABLE clinlims.micro_report_version ADD CONSTRAINT micro_report_version_type_chk CHECK (release_type IN ('FINAL','AMENDED'));</sql>
<sql>CREATE UNIQUE INDEX uq_micro_ast_run_reportable ON clinlims.micro_ast_run (isolate_id) WHERE reportable = true AND status = 'REVIEWED';</sql>
<dropColumn schemaName="clinlims" tableName="micro_case_analysis" columnName="selected_for_report"/>
<dropColumn schemaName="clinlims" tableName="micro_report_version" columnName="structured_content"/>
<dropUniqueConstraint schemaName="clinlims" tableName="micro_ast_reading" constraintName="uq_micro_ast_reading_sequence"/><dropColumn schemaName="clinlims" tableName="micro_ast_reading" columnName="entry_sequence"/></rollback></changeSet></databaseChangeLog>
