<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <!--
    OGC-804 — notification event for the configurable trigger system:
    REFERRAL_REJECTED_NEEDS_RECOLLECTION. Fires after a returned result is
    rejected (ReferralServiceImpl.markReferralRejected), prompting the ordering
    clinician to re-collect. Seeded disabled; admin activates channels/recipients
    via the existing admin screen. Variables: [sampleAccessionNumber], [referralId],
    [patientFirstName], [patientLastName], [testName], [labName], [rejectReason],
    [deepLink].
  -->

  <changeSet id="3.5.0.0-056-seed-referral-rejected-template" author="samuelmale">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM clinlims.notification_payload_template
        WHERE type = 'REFERRAL_REJECTED_NEEDS_RECOLLECTION'
      </sqlCheck>
    </preConditions>
    <insert tableName="notification_payload_template" schemaName="clinlims">
      <column name="id" valueComputed="nextval('clinlims.notification_payload_template_seq')"/>
      <column name="type" value="REFERRAL_REJECTED_NEEDS_RECOLLECTION"/>
      <column name="subject_template" value="Re-collection needed: [sampleAccessionNumber]"/>
      <column name="message_template" value="Result for sample [sampleAccessionNumber] (patient [patientFirstName] [patientLastName], test [testName]) returned by [labName] was rejected: [rejectReason]. Please re-collect and re-refer. Order: [deepLink]"/>
      <column name="last_updated" valueComputed="now()"/>
    </insert>
    <rollback>
      <delete tableName="notification_payload_template" schemaName="clinlims">
        <where>type = 'REFERRAL_REJECTED_NEEDS_RECOLLECTION'</where>
      </delete>
    </rollback>
  </changeSet>

  <changeSet id="3.5.0.0-056-seed-referral-rejected-trigger" author="samuelmale">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM clinlims.notification_trigger_config
        WHERE event_code = 'REFERRAL_REJECTED_NEEDS_RECOLLECTION'
      </sqlCheck>
    </preConditions>
    <insert tableName="notification_trigger_config" schemaName="clinlims">
      <column name="id" valueComputed="nextval('clinlims.notification_trigger_config_seq')"/>
      <column name="event_code" value="REFERRAL_REJECTED_NEEDS_RECOLLECTION"/>
      <column name="enabled" valueBoolean="false"/>
      <column name="payload_template_id"
              valueComputed="(SELECT id FROM clinlims.notification_payload_template
                              WHERE type = 'REFERRAL_REJECTED_NEEDS_RECOLLECTION')"/>
      <column name="last_updated" valueComputed="now()"/>
    </insert>
    <rollback>
      <delete tableName="notification_trigger_config" schemaName="clinlims">
        <where>event_code = 'REFERRAL_REJECTED_NEEDS_RECOLLECTION'</where>
      </delete>
    </rollback>
  </changeSet>

</databaseChangeLog>
