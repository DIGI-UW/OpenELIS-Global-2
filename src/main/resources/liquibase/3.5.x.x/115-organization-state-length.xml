<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- OGC-1420 (6d): State / Province held two characters, a US state code. A
         province or region name ("National Capital District") is what labs enter. -->
    <changeSet id="OGC-1420-organization-state-length" author="mozzy11">
        <comment>Organization State / Province holds a name, not a two-letter code</comment>
        <modifyDataType schemaName="clinlims" tableName="organization" columnName="state" newDataType="varchar(100)"/>
        <rollback>
            <modifyDataType schemaName="clinlims" tableName="organization" columnName="state" newDataType="varchar(2)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
