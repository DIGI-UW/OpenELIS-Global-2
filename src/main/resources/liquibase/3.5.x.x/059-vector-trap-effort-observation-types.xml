<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <!-- V-04 (OGC-585) collection density: trapping-effort observations captured on
       the vector sample-entry form. Their product (traps x nights) is the sampling
       effort used to compute organisms per trap-night. Mirrors the vecTrapTypeId /
       vecLifecycleStage observation types (3.4.x.x/022). -->

  <changeSet id="3.5.0.0-add-vec-trap-count" author="vector-surveillance">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM clinlims.observation_history_type WHERE type_name = 'vecTrapCount'
      </sqlCheck>
    </preConditions>
    <insert tableName="observation_history_type" schemaName="clinlims">
      <column name="id" valueSequenceNext="observation_history_type_seq"/>
      <column name="type_name" value="vecTrapCount"/>
      <column name="description" value="Number of traps deployed for the collection (sampling effort)"/>
      <column name="lastupdated" valueDate="CURRENT_TIMESTAMP"/>
    </insert>
  </changeSet>

  <changeSet id="3.5.0.0-add-vec-trap-nights" author="vector-surveillance">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM clinlims.observation_history_type WHERE type_name = 'vecTrapNights'
      </sqlCheck>
    </preConditions>
    <insert tableName="observation_history_type" schemaName="clinlims">
      <column name="id" valueSequenceNext="observation_history_type_seq"/>
      <column name="type_name" value="vecTrapNights"/>
      <column name="description" value="Number of nights the traps were deployed (sampling effort)"/>
      <column name="lastupdated" valueDate="CURRENT_TIMESTAMP"/>
    </insert>
  </changeSet>

</databaseChangeLog>
