<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="OGC-782-microbiology-patient-origin-reference" author="OpenELIS">
    <createTable schemaName="clinlims" tableName="micro_patient_origin">
      <column name="id" type="varchar(36)" defaultValueComputed="gen_random_uuid()::varchar">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="code" type="varchar(40)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="display_name" type="varchar(100)">
        <constraints nullable="false"/>
      </column>
      <column name="whonet_code" type="varchar(10)">
        <constraints nullable="false"/>
      </column>
      <column name="is_active" type="varchar(2)" defaultValue="Y">
        <constraints nullable="false"/>
      </column>
      <column name="sort_order" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="last_updated" type="timestamp" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createTable schemaName="clinlims" tableName="micro_patient_origin_default">
      <column name="id" type="varchar(36)" defaultValueComputed="gen_random_uuid()::varchar">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="organization_id" type="numeric(10)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="patient_origin_id" type="varchar(36)">
        <constraints nullable="false"/>
      </column>
      <column name="last_updated" type="timestamp" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableSchemaName="clinlims"
      baseTableName="micro_patient_origin_default"
      baseColumnNames="organization_id"
      constraintName="fk_micro_patient_origin_default_org"
      referencedTableSchemaName="clinlims"
      referencedTableName="organization"
      referencedColumnNames="id"/>
    <addForeignKeyConstraint
      baseTableSchemaName="clinlims"
      baseTableName="micro_patient_origin_default"
      baseColumnNames="patient_origin_id"
      constraintName="fk_micro_patient_origin_default_origin"
      referencedTableSchemaName="clinlims"
      referencedTableName="micro_patient_origin"
      referencedColumnNames="id"/>

    <insert schemaName="clinlims" tableName="micro_patient_origin">
      <column name="code" value="INPATIENT"/>
      <column name="display_name" value="Inpatient"/>
      <column name="whonet_code" value="INP"/>
      <column name="sort_order" valueNumeric="10"/>
    </insert>
    <insert schemaName="clinlims" tableName="micro_patient_origin">
      <column name="code" value="OUTPATIENT"/>
      <column name="display_name" value="Outpatient"/>
      <column name="whonet_code" value="OUT"/>
      <column name="sort_order" valueNumeric="20"/>
    </insert>
    <insert schemaName="clinlims" tableName="micro_patient_origin">
      <column name="code" value="INTENSIVE_CARE"/>
      <column name="display_name" value="ICU"/>
      <column name="whonet_code" value="ICU"/>
      <column name="sort_order" valueNumeric="30"/>
    </insert>
    <insert schemaName="clinlims" tableName="micro_patient_origin">
      <column name="code" value="EMERGENCY"/>
      <column name="display_name" value="Emergency"/>
      <column name="whonet_code" value="EME"/>
      <column name="sort_order" valueNumeric="40"/>
    </insert>
    <insert schemaName="clinlims" tableName="micro_patient_origin">
      <column name="code" value="LONG_TERM_CARE"/>
      <column name="display_name" value="Long-term Care"/>
      <column name="whonet_code" value="LTC"/>
      <column name="sort_order" valueNumeric="50"/>
    </insert>
    <insert schemaName="clinlims" tableName="micro_patient_origin">
      <column name="code" value="UNKNOWN"/>
      <column name="display_name" value="Unknown"/>
      <column name="whonet_code" value="UNK"/>
      <column name="sort_order" valueNumeric="60"/>
    </insert>

    <rollback>
      <dropTable schemaName="clinlims" tableName="micro_patient_origin_default"/>
      <dropTable schemaName="clinlims" tableName="micro_patient_origin"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
