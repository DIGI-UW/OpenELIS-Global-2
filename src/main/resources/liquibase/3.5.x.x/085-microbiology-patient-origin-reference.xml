<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="OGC-782-microbiology-patient-origin-reference" author="OpenELIS">
    <validCheckSum>8:f0808f24d6306b697fdf5cb79f4caa24</validCheckSum>
    <createTable schemaName="clinlims" tableName="micro_patient_origin">
      <column name="id" type="varchar(36)" defaultValueComputed="gen_random_uuid()::varchar">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="code" type="varchar(40)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="display_name" type="varchar(100)">
        <constraints nullable="false"/>
      </column>
      <column name="whonet_code" type="varchar(10)">
        <constraints nullable="false"/>
      </column>
      <column name="is_active" type="varchar(2)" defaultValue="Y">
        <constraints nullable="false"/>
      </column>
      <column name="sort_order" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="last_updated" type="timestamp" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createTable schemaName="clinlims" tableName="micro_patient_origin_default">
      <column name="id" type="varchar(36)" defaultValueComputed="gen_random_uuid()::varchar">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="organization_id" type="numeric(10)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="patient_origin_id" type="varchar(36)">
        <constraints nullable="false"/>
      </column>
      <column name="last_updated" type="timestamp" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableSchemaName="clinlims"
      baseTableName="micro_patient_origin_default"
      baseColumnNames="organization_id"
      constraintName="fk_micro_patient_origin_default_org"
      referencedTableSchemaName="clinlims"
      referencedTableName="organization"
      referencedColumnNames="id"/>
    <addForeignKeyConstraint
      baseTableSchemaName="clinlims"
      baseTableName="micro_patient_origin_default"
      baseColumnNames="patient_origin_id"
      constraintName="fk_micro_patient_origin_default_origin"
      referencedTableSchemaName="clinlims"
      referencedTableName="micro_patient_origin"
      referencedColumnNames="id"/>

    <rollback>
      <dropTable schemaName="clinlims" tableName="micro_patient_origin_default"/>
      <dropTable schemaName="clinlims" tableName="micro_patient_origin"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
