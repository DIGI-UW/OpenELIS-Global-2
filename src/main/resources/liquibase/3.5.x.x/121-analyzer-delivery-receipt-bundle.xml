<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="121-analyzer-delivery-receipt-bundle" author="oe">
        <comment>Keep the normalized FHIR bundle of every accepted delivery with its receipt, so what the Bridge parsed stays readable after the staged results are reviewed.</comment>
        <addColumn schemaName="clinlims" tableName="analyzer_delivery_receipt">
            <column name="bundle_json" type="TEXT"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="analyzer_delivery_receipt" columnName="bundle_json"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
