<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    Corrective cleanup. Earlier iterations of this branch shipped changesets
    (069-inventory-item-type.xml and 071-fix-inventory-item-type-last-updated.xml,
    since deleted from this branch entirely) that created an admin-managed
    inventory_item_type table (OGC-658 Part A) and swapped inventory_item's
    chk_item_type CHECK constraint for an FK into it. That design was
    superseded before merging — item "type" becomes a free-form tag in the
    inventory redesign, so the managed table is not wanted. Fresh databases
    never see any of it (the creating changesets are gone), but any
    environment that already ran them (Liquibase tracks changesets by
    id+author in DATABASECHANGELOG and does not retroactively undo one just
    because its file was deleted) is left with the table, its sequence, and
    the FK. This changeset restores the pre-Part-A shape wherever the drift
    exists: FK removed, original CHECK restored, table and sequence dropped.
    The seeded localization/localization_value rows the table pointed at are
    left in place (harmless orphans; deleting them risks colliding with
    unrelated rows).
    -->
    <changeSet id="OGC-658-drop-inventory-item-type-fk" author="OGC">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'fk_inventory_item_type_code'
                  AND conrelid = 'clinlims.inventory_item'::regclass;
            </sqlCheck>
        </preConditions>
        <comment>Drop the superseded FK from inventory_item.item_type to inventory_item_type(code)</comment>
        <sql>
            ALTER TABLE clinlims.inventory_item
            DROP CONSTRAINT fk_inventory_item_type_code;
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="OGC-658-restore-item-type-check" author="OGC">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM pg_constraint WHERE conname = 'chk_item_type'
                      AND conrelid = 'clinlims.inventory_item'::regclass;
                </sqlCheck>
                <!-- A dev DB that ran Part A may hold admin-created types outside the
                    original five; adding the CHECK there would fail and block startup.
                    Skip it for such DBs (acceptable drift — type becomes a free-form
                    tag in the redesign anyway). -->
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM clinlims.inventory_item
                    WHERE item_type NOT IN ('REAGENT', 'RDT', 'CARTRIDGE', 'HIV_KIT', 'SYPHILIS_KIT');
                </sqlCheck>
            </and>
        </preConditions>
        <comment>Restore the original chk_item_type CHECK (dropped when the FK replaced it)</comment>
        <sql>
            ALTER TABLE clinlims.inventory_item
            ADD CONSTRAINT chk_item_type
            CHECK (item_type IN ('REAGENT', 'RDT', 'CARTRIDGE', 'HIV_KIT', 'SYPHILIS_KIT'));
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="OGC-658-drop-inventory-item-type-table" author="OGC">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="inventory_item_type" schemaName="clinlims"/>
        </preConditions>
        <comment>Drop the superseded inventory_item_type table and its sequence</comment>
        <dropTable tableName="inventory_item_type" schemaName="clinlims"/>
        <sql>DROP SEQUENCE IF EXISTS clinlims.inventory_item_type_seq;</sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
