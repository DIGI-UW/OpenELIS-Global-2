<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    Programs V2 lifecycle - `program.is_active` is the deactivate/reactivate
    state. There is no hard-delete path: deactivated programs drop out of the
    order-entry picker but keep their historical orders and indicator counts.
    Stored as 'Y'/'N' to match panel / test / test_section, which the shared
    admin-list code already renders on. Existing rows backfill to 'Y'.
    -->

    <changeSet id="programs-v2-active-column" author="herbert">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="program" columnName="is_active"/>
            </not>
        </preConditions>
        <addColumn schemaName="clinlims" tableName="program">
            <column name="is_active" type="VARCHAR(1)" defaultValue="Y">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE clinlims.program
            ADD CONSTRAINT program_is_active_chk
            CHECK (is_active IN ('Y', 'N'))
        </sql>
        <rollback>
            <sql>ALTER TABLE clinlims.program DROP CONSTRAINT program_is_active_chk</sql>
            <dropColumn schemaName="clinlims" tableName="program" columnName="is_active"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
