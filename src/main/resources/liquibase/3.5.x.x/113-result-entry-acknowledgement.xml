<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- OGC-1417: the person entering a result acknowledges a critical value, and
         confirms a value outside the valid range, before the save goes through.
         One row records one acknowledgement: who, when, the value as entered and
         the message they were shown, on the screen they used. Rows are write-once
         and are themselves the record, so the table is not registered for generic
         audit history and uses a UUID id, like critical_callback. -->

    <changeSet author="mozzy11" id="OGC-1417-result-entry-acknowledgement">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="result_entry_acknowledgement" schemaName="clinlims"/></not>
        </preConditions>
        <createTable schemaName="clinlims" tableName="result_entry_acknowledgement">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_result_entry_acknowledgement"/>
            </column>
            <column name="analysis_id" type="numeric(10)">
                <constraints nullable="false"/>
            </column>
            <column name="result_id" type="numeric(10)"/>
            <column name="kind" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="result_value" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="VARCHAR(1000)"/>
            <column name="source" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="acknowledged_by" type="numeric(10)">
                <constraints nullable="false"/>
            </column>
            <column name="acknowledged_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP"/>
        </createTable>

        <sql>
            ALTER TABLE clinlims.result_entry_acknowledgement
            ADD CONSTRAINT result_entry_acknowledgement_kind_chk
            CHECK (kind IN ('CRITICAL_ACKNOWLEDGED', 'INVALID_CONFIRMED'))
        </sql>

        <addForeignKeyConstraint
            constraintName="fk_result_entry_ack_analysis"
            baseTableSchemaName="clinlims" baseTableName="result_entry_acknowledgement" baseColumnNames="analysis_id"
            referencedTableSchemaName="clinlims" referencedTableName="analysis" referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            constraintName="fk_result_entry_ack_result"
            baseTableSchemaName="clinlims" baseTableName="result_entry_acknowledgement" baseColumnNames="result_id"
            referencedTableSchemaName="clinlims" referencedTableName="result" referencedColumnNames="id"
            onDelete="SET NULL"/>

        <createIndex schemaName="clinlims" tableName="result_entry_acknowledgement"
            indexName="idx_result_entry_ack_analysis">
            <column name="analysis_id"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="clinlims" tableName="result_entry_acknowledgement"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
