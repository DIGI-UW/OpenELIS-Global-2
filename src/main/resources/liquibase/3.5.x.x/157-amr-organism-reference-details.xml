<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
 <changeSet id="157-amr-organism-reference-details" author="openelis">
  <addColumn schemaName="clinlims" tableName="micro_organism">
   <column name="whonet_name" type="varchar(255)"/>
   <column name="taxonomic_rank" type="varchar(40)"/>
   <column name="prevalence" type="numeric(4,2)"/>
  </addColumn>
 </changeSet>
 <changeSet id="157-amr-organism-name-and-code-lookup" author="openelis">
  <sql>CREATE INDEX idx_micro_organism_display_name_lower ON clinlims.micro_organism (lower(display_name));
   CREATE INDEX idx_micro_organism_whonet_code_lower ON clinlims.micro_organism (lower(whonet_code));</sql>
  <rollback>
   <sql>DROP INDEX clinlims.idx_micro_organism_display_name_lower;
    DROP INDEX clinlims.idx_micro_organism_whonet_code_lower;</sql>
  </rollback>
 </changeSet>
</databaseChangeLog>
