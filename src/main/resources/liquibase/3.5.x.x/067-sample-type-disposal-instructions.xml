<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- OGC-296 v2.1 Dependency 2: free-text disposal instructions on the
         sample type — a lightweight reference; the authoritative structured
         handling stays per-test (TestSampleHandling) and per-specimen
         (Sample Storage disposal). -->
    <changeSet id="sample-type-disposal-instructions" author="OGC">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="type_of_sample" columnName="disposal_instructions"/>
            </not>
        </preConditions>
        <addColumn schemaName="clinlims" tableName="type_of_sample">
            <column name="disposal_instructions" type="TEXT"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="type_of_sample" columnName="disposal_instructions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
