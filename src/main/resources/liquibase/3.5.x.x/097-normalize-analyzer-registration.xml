<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="097-normalize-analyzer-registration" author="openelis">
        <comment>Retain lifecycle and menu updates independently of deferred analyzer data cleanup.</comment>
        <update tableName="analyzer" schemaName="clinlims">
            <column name="status" value="SETUP"/>
            <where>status = 'PENDING_REGISTRATION'</where>
        </update>
        <delete tableName="menu" schemaName="clinlims">
            <where>element_id = 'menu_analyzers_errors'</where>
        </delete>
        <rollback/>
    </changeSet>
</databaseChangeLog>
