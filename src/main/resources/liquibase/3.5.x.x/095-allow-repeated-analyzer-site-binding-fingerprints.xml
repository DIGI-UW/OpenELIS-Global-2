<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="OGC-1054-allow-repeated-site-binding-fingerprints" author="OGC">
        <comment>
            A fingerprint identifies mapping content, not a unique historical
            event. Allow a later immutable revision to restore the content of an
            earlier revision after an intervening change.
        </comment>
        <dropUniqueConstraint schemaName="clinlims"
            tableName="analyzer_site_binding_revision"
            constraintName="uq_analyzer_site_binding_revision_fingerprint"/>
        <rollback>
            <addUniqueConstraint schemaName="clinlims"
                tableName="analyzer_site_binding_revision"
                columnNames="site_binding_id, binding_fingerprint"
                constraintName="uq_analyzer_site_binding_revision_fingerprint"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
