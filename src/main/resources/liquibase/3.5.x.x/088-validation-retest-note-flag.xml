<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    OGC-1030 (Validation v4 slice V4, FR-D3) — "Retest note required".
    When on, a validator sending a result back for retest must give the bench a
    note. Default off: today's page files a retest with no note, so the default
    changes nothing until a lab opts in.
    -->
    <changeSet id="OGC-1030-validation-retest-note-flag" author="OGC">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(*) from clinlims.site_information where name = 'retestNoteRequired';</sqlCheck>
        </preConditions>
        <comment>Site flag requiring a note when a validator sends a result for retest (OGC-1030); default off</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id" valueSequenceNext="site_information_seq" />
            <column name="name" value="retestNoteRequired" />
            <column name="lastupdated" valueComputed="${now}" />
            <column name="description" value="If true, a validator must write a note for the bench when sending a result back for retest" />
            <column name="value" value="false" />
            <column name="encrypted" value="false" />
            <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'resultConfiguration')" />
            <column name="value_type" value="boolean" />
            <column name="instruction_key" value="instructions.validation.retest.note" />
            <column name="group" value="0" />
        </insert>
    </changeSet>

</databaseChangeLog>
