<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="OGC-1054-analyzer-activation-record" author="OGC">
        <comment>
            Store the OpenELIS reference to one durable Bridge connection and retain
            each exact Bridge runtime acknowledgement as immutable audit evidence.
        </comment>

        <createSequence schemaName="clinlims" sequenceName="analyzer_activation_record_seq"
            startValue="1" incrementBy="1"/>
        <createTable schemaName="clinlims" tableName="analyzer_activation_record">
            <column name="id" type="numeric(10)">
                <constraints primaryKey="true" nullable="false"
                    primaryKeyName="pk_analyzer_activation_record"/>
            </column>
            <column name="analyzer_id" type="numeric(10)">
                <constraints nullable="false"/>
            </column>
            <column name="site_binding_revision_id" type="numeric(10)"/>
            <column name="verification_confirmation_id" type="numeric(10)"/>
            <column name="bridge_connection_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="activation_intent" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="runtime_acknowledgement_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="runtime_fingerprint" type="VARCHAR(71)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_analyzer_activation_record_analyzer"
            baseTableSchemaName="clinlims" baseTableName="analyzer_activation_record"
            baseColumnNames="analyzer_id" referencedTableSchemaName="clinlims"
            referencedTableName="analyzer" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_analyzer_activation_record_binding_revision"
            baseTableSchemaName="clinlims" baseTableName="analyzer_activation_record"
            baseColumnNames="site_binding_revision_id" referencedTableSchemaName="clinlims"
            referencedTableName="analyzer_site_binding_revision" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_analyzer_activation_record_confirmation"
            baseTableSchemaName="clinlims" baseTableName="analyzer_activation_record"
            baseColumnNames="verification_confirmation_id" referencedTableSchemaName="clinlims"
            referencedTableName="analyzer_site_binding_confirmation" referencedColumnNames="id"/>
        <createIndex schemaName="clinlims" tableName="analyzer_activation_record"
            indexName="idx_analyzer_activation_record_analyzer">
            <column name="analyzer_id"/>
        </createIndex>
        <sql>
            ALTER TABLE clinlims.analyzer_activation_record
            ADD CONSTRAINT chk_analyzer_activation_record_intent
            CHECK (activation_intent IN ('ACTIVE', 'INACTIVE'));
        </sql>
        <sql>
            ALTER TABLE clinlims.analyzer_activation_record
            ADD CONSTRAINT chk_analyzer_activation_record_fingerprint
            CHECK (runtime_fingerprint ~ '^sha256:[0-9a-f]{64}$');
        </sql>

        <addColumn schemaName="clinlims" tableName="analyzer">
            <column name="bridge_connection_id" type="VARCHAR(255)"/>
            <column name="latest_activation_record_id" type="numeric(10)"/>
        </addColumn>
        <addUniqueConstraint schemaName="clinlims" tableName="analyzer"
            columnNames="bridge_connection_id" constraintName="uq_analyzer_bridge_connection"/>
        <addForeignKeyConstraint constraintName="fk_analyzer_latest_activation_record"
            baseTableSchemaName="clinlims" baseTableName="analyzer"
            baseColumnNames="latest_activation_record_id" referencedTableSchemaName="clinlims"
            referencedTableName="analyzer_activation_record" referencedColumnNames="id"/>
        <createIndex schemaName="clinlims" tableName="analyzer"
            indexName="idx_analyzer_latest_activation_record">
            <column name="latest_activation_record_id"/>
        </createIndex>

        <rollback>
            <dropForeignKeyConstraint baseTableSchemaName="clinlims" baseTableName="analyzer"
                constraintName="fk_analyzer_latest_activation_record"/>
            <dropUniqueConstraint schemaName="clinlims" tableName="analyzer"
                constraintName="uq_analyzer_bridge_connection"/>
            <dropColumn schemaName="clinlims" tableName="analyzer" columnName="latest_activation_record_id"/>
            <dropColumn schemaName="clinlims" tableName="analyzer" columnName="bridge_connection_id"/>
            <dropTable schemaName="clinlims" tableName="analyzer_activation_record"/>
            <dropSequence schemaName="clinlims" sequenceName="analyzer_activation_record_seq"/>
        </rollback>
    </changeSet>

    <changeSet id="OGC-1054-analyzer-activation-record-audit" author="OGC">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.reference_tables
                WHERE LOWER(name) = 'analyzer_activation_record'
            </sqlCheck>
        </preConditions>
        <insert schemaName="clinlims" tableName="reference_tables">
            <column name="id" valueSequenceNext="reference_tables_seq"/>
            <column name="name" value="analyzer_activation_record"/>
            <column name="keep_history" value="Y"/>
            <column name="lastupdated" valueDate="now()"/>
        </insert>
        <rollback>
            <delete schemaName="clinlims" tableName="reference_tables">
                <where>LOWER(name) = 'analyzer_activation_record'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
