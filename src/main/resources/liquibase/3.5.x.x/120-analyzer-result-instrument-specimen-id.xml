<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="120-analyzer-result-instrument-specimen-id" author="oe">
        <comment>Keep the specimen ID an instrument reported, verbatim, beside the accession it resolved to, so a tube ID can be placed on its own tube.</comment>
        <addColumn schemaName="clinlims" tableName="analyzer_results">
            <column name="instrument_specimen_id" type="VARCHAR(255)"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="analyzer_results" columnName="instrument_specimen_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
