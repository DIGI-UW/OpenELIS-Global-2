<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- OpenELIS's own key pair for calls to the Analyzer Bridge, and the Bridge
         certificate it pinned when the two paired. The private key is stored
         encrypted. -->
    <changeSet id="analyzer-bridge-pairing" author="OGC">
        <createSequence schemaName="clinlims" sequenceName="analyzer_bridge_pairing_seq"
            startValue="1" incrementBy="1"/>
        <createTable schemaName="clinlims" tableName="analyzer_bridge_pairing">
            <column name="id" type="numeric(10)">
                <constraints primaryKey="true" nullable="false"
                    primaryKeyName="pk_analyzer_bridge_pairing"/>
            </column>
            <column name="client_private_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="client_certificate" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="bridge_url" type="VARCHAR(512)"/>
            <column name="bridge_certificate" type="TEXT"/>
            <column name="bridge_certificate_sha256" type="VARCHAR(64)"/>
            <column name="paired_at" type="TIMESTAMP"/>
            <column name="paired_by" type="VARCHAR(20)"/>
            <column name="last_updated" type="TIMESTAMP"/>
        </createTable>
        <rollback>
            <dropTable schemaName="clinlims" tableName="analyzer_bridge_pairing"/>
            <dropSequence schemaName="clinlims" sequenceName="analyzer_bridge_pairing_seq"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
