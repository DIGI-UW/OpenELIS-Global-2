<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
    history.reference_id is numeric, but some audited tables are keyed by a
    UUID string (qc_control_lot, registered for audit by 026). Writing their
    history row failed with a NumberFormatException, and because the audit
    runs inside the save, every control lot edit and retirement answered 500.

    A history row now carries a numeric key in reference_id or a string key in
    reference_key, never both; existing rows and readers are unchanged. Rolling
    back deletes the string-keyed rows, which the old schema cannot hold, and
    restores NOT NULL on reference_id.
    -->

    <changeSet id="history-reference-key-add-column" author="mozzy11">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="history" columnName="reference_key"/>
            </not>
        </preConditions>
        <addColumn schemaName="clinlims" tableName="history">
            <column name="reference_key" type="varchar(64)"/>
        </addColumn>
        <dropNotNullConstraint schemaName="clinlims" tableName="history" columnName="reference_id"
            columnDataType="numeric"/>
        <createIndex schemaName="clinlims" tableName="history" indexName="history_reference_key_idx">
            <column name="reference_table"/>
            <column name="reference_key"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="clinlims" tableName="history" indexName="history_reference_key_idx"/>
            <delete schemaName="clinlims" tableName="history">
                <where>reference_id IS NULL</where>
            </delete>
            <addNotNullConstraint schemaName="clinlims" tableName="history" columnName="reference_id"
                columnDataType="numeric"/>
            <dropColumn schemaName="clinlims" tableName="history" columnName="reference_key"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
