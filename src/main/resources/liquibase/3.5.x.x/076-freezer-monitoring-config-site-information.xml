<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet author="cold-storage-monitoring-audit" id="076-freezer-monitoring-config-site-information">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        select count(*) from clinlims.site_information where name = 'freezer.monitoring.enabled';
      </sqlCheck>
    </preConditions>
    <comment>Move the freezer monitoring enabled flag and Modbus timeout out of a
      static properties file (org.openelisglobal.freezermonitoring.enabled /
      .modbus.timeout-millis) and into SiteInformation, matching the existing
      freezer.modbus.tcp.port / freezer.bacnet.udp.port pattern, so an admin can
      toggle monitoring or raise the timeout for a slow cross-subnet/VPN link from
      the System Configuration screen without a restart (GitHub issue #3904).</comment>

    <insert schemaName="clinlims" tableName="site_information">
      <column name="id" valueSequenceNext="site_information_seq" />
      <column name="name" value="freezer.monitoring.enabled" />
      <column name="lastupdated" valueComputed="${now}" />
      <column name="description" value="Enable/disable freezer Modbus polling (default: true)" />
      <column name="encrypted" value="false" />
      <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'siteIdentity')" />
      <column name="value_type" value="text" />
      <column name="value" value="true" />
      <column name="group" value="0" />
    </insert>

    <insert schemaName="clinlims" tableName="site_information">
      <column name="id" valueSequenceNext="site_information_seq" />
      <column name="name" value="freezer.modbus.timeout.ms" />
      <column name="lastupdated" valueComputed="${now}" />
      <column name="description" value="Modbus connect/request timeout in milliseconds (default: 2000)" />
      <column name="encrypted" value="false" />
      <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'siteIdentity')" />
      <column name="value_type" value="text" />
      <column name="value" value="2000" />
      <column name="group" value="0" />
    </insert>

    <rollback>
      <delete schemaName="clinlims" tableName="site_information">
        <where>name IN ('freezer.monitoring.enabled', 'freezer.modbus.timeout.ms')</where>
      </delete>
    </rollback>
  </changeSet>

</databaseChangeLog>
