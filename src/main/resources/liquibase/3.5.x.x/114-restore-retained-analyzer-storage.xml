<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <!-- Re-creates, empty, the retained analyzer storage that the read-only
         AnalyzerUpgrade* entities map, on databases where the removed
         changesets OGC-1054-remove-openelis-analyzer-connection-runtime (094)
         and 098-remove-superseded-analyzer-schema dropped it. Definitions match
         a database built from the full changelog. Each changeset is MARK_RAN
         where its object exists. Other objects those changesets dropped are not
         read by any code and are not re-created.

         The rollbacks are empty on purpose. Liquibase 4.8 executes a
         changeset's rollback for MARK_RAN rows too, so dropping these objects
         on rollback would delete the populated retained storage of every
         database that already had it. Omitting <rollback> would generate the
         same drops. -->

    <changeSet id="114-restore-analyzer-type" author="pmanko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="analyzer_type"/>
            </not>
        </preConditions>
        <createTable tableName="analyzer_type">
            <column name="id" type="NUMERIC(10,0)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="analyzer_type_pkey"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="analyzer_type_name_key"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="protocol" type="VARCHAR(30)" defaultValue="ASTM">
                <constraints nullable="false"/>
            </column>
            <column name="plugin_class_name" type="VARCHAR(255)"/>
            <column name="identifier_pattern" type="VARCHAR(500)"/>
            <column name="is_generic_plugin" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sys_user_id" type="VARCHAR(36)"/>
            <column name="last_updated" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback/>
    </changeSet>

    <changeSet id="114-restore-analyzer-type-reference" author="pmanko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="analyzer" columnName="analyzer_type_id"/>
            </not>
        </preConditions>
        <addColumn tableName="analyzer">
            <column name="analyzer_type_id" type="NUMERIC(10,0)"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_analyzer_analyzer_type"
            baseTableName="analyzer" baseColumnNames="analyzer_type_id"
            referencedTableName="analyzer_type" referencedColumnNames="id"/>
        <rollback/>
    </changeSet>

    <changeSet id="114-restore-analyzer-connection-settings" author="pmanko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="analyzer" columnName="ip_address"/>
            </not>
        </preConditions>
        <addColumn tableName="analyzer">
            <column name="ip_address" type="VARCHAR(15)"/>
            <column name="port" type="INTEGER"/>
            <column name="communication_mode" type="VARCHAR(25)"/>
            <column name="import_directory" type="VARCHAR(500)"/>
            <column name="file_pattern" type="VARCHAR(100)"/>
            <column name="column_mappings_json" type="TEXT"/>
            <column name="file_format" type="VARCHAR(30)"/>
        </addColumn>
        <rollback/>
    </changeSet>

    <changeSet id="114-restore-analyzer-test-map" author="pmanko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="analyzer_test_map"/>
            </not>
        </preConditions>
        <createTable tableName="analyzer_test_map">
            <column name="analyzer_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="analyzer_test_name" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="test_id" type="NUMERIC(10,0)"/>
            <column name="last_updated" type="TIMESTAMP WITH TIME ZONE"
                defaultValueComputed="'2011-12-27 23:41:40.194936+00'::timestamp with time zone"/>
            <column name="component_id" type="VARCHAR(36)"/>
        </createTable>
        <addPrimaryKey tableName="analyzer_test_map" columnNames="analyzer_id, analyzer_test_name"
            constraintName="analyzer_test_map_pk"/>
        <addForeignKeyConstraint constraintName="analyzer_test_map_analyzer_fk"
            baseTableName="analyzer_test_map" baseColumnNames="analyzer_id"
            referencedTableName="analyzer" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint constraintName="analyzer_test_map_test_fk"
            baseTableName="analyzer_test_map" baseColumnNames="test_id"
            referencedTableName="test" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_analyzer_test_map_component"
            baseTableName="analyzer_test_map" baseColumnNames="component_id"
            referencedTableName="test_result_component" referencedColumnNames="id" onDelete="SET NULL"/>
        <rollback/>
    </changeSet>

    <changeSet id="114-restore-analyzer-plugin-config" author="pmanko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="analyzer_plugin_config"/>
            </not>
        </preConditions>
        <createTable tableName="analyzer_plugin_config">
            <column name="analyzer_id" type="NUMERIC(10,0)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="analyzer_plugin_config_pkey"/>
            </column>
            <column name="config" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="sys_user_id" type="VARCHAR(36)"/>
            <column name="last_updated" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="analyzer_plugin_config_analyzer_fk"
            baseTableName="analyzer_plugin_config" baseColumnNames="analyzer_id"
            referencedTableName="analyzer" referencedColumnNames="id" onDelete="CASCADE"/>
        <rollback/>
    </changeSet>

    <changeSet id="114-restore-serial-port-configuration" author="pmanko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="serial_port_configuration"/>
            </not>
        </preConditions>
        <createTable tableName="serial_port_configuration">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="serial_port_configuration_pkey"/>
            </column>
            <column name="analyzer_id" type="NUMERIC(10,0)">
                <constraints nullable="false" unique="true"
                    uniqueConstraintName="serial_port_configuration_analyzer_id_key"/>
            </column>
            <column name="port_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="baud_rate" type="INTEGER" defaultValueNumeric="9600">
                <constraints nullable="false"/>
            </column>
            <column name="data_bits" type="INTEGER" defaultValueNumeric="8">
                <constraints nullable="false"/>
            </column>
            <column name="stop_bits" type="VARCHAR(10)" defaultValue="ONE">
                <constraints nullable="false"/>
            </column>
            <column name="parity" type="VARCHAR(10)" defaultValue="NONE">
                <constraints nullable="false"/>
            </column>
            <column name="flow_control" type="VARCHAR(20)" defaultValue="NONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true"
                    uniqueConstraintName="serial_port_configuration_fhir_uuid_key"/>
            </column>
            <column name="sys_user_id" type="VARCHAR(36)"/>
            <column name="last_updated" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_serial_port_analyzer"
            baseTableName="serial_port_configuration" baseColumnNames="analyzer_id"
            referencedTableName="analyzer" referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="serial_port_configuration" indexName="idx_serial_port_config_active">
            <column name="active"/>
        </createIndex>
        <createIndex tableName="serial_port_configuration" indexName="idx_serial_port_config_analyzer">
            <column name="analyzer_id"/>
        </createIndex>
        <rollback/>
    </changeSet>
</databaseChangeLog>
