<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
<changeSet id="159-amr-v3-panel-default-claims" author="openelis">
<comment>Keep each panel's defaultFor entries and the file that set them, so default panels resolve across every panel file.</comment>
<addColumn schemaName="clinlims" tableName="micro_ast_panel">
<column name="default_for" type="TEXT"/>
<column name="default_for_file" type="VARCHAR(255)"/>
</addColumn>
<rollback>
<dropColumn schemaName="clinlims" tableName="micro_ast_panel" columnName="default_for_file"/>
<dropColumn schemaName="clinlims" tableName="micro_ast_panel" columnName="default_for"/>
</rollback>
</changeSet>
</databaseChangeLog>
