        type row, which the range formatter keys on. -->
    <result_limits id="1" test_id="1" test_result_type_id="1"
        min_age="0" max_age="120" low_normal="5.0" high_normal="20.0"
        low_valid="0.0" high_valid="100.0" low_reporting_range="0.0"
