    <!-- status_of_sample The COMPLETE canonical catalog, reproducing postgre-db-init/OpenELIS-Global.sql
        row for row (same ids, names, display_keys and is_active flags), plus the
        five rows the liquibase changesets add on top of that seed. Why the whole
        catalog, and why these exact ids: executeDataSetWithStateManagement TRUNCATEs
        (RESTART IDENTITY CASCADE) every table a dataset names and then REFRESHes
        only that dataset's own rows. A fixture that declares a SUBSET of status_of_sample
        therefore deletes every status it omits, and the next test to resolve one
        by name gets "-1" and dies on an FK such as analysis_status_fk. Declaring
        the full seed makes this load restore the catalog rather than replace it,
        so tests that run after this one still see the ids and names the database
        was seeded with. Omitting the table is not an option either: an earlier fixture
        in the suite may already have replaced the catalog with its own banding,
        which is exactly how status_id=1 came to be missing here. Names are matched
        verbatim by StatusService.addTo*Map(); changing one silently unmaps that
        status. Table order matters too, because DBUnit inserts tables in declaration
        order, so this block has to precede sample, sample_item and analysis. -->
    <status_of_sample id="1" name="Test Entered"
        status_type="ORDER"
        description="No tests have been run for this order" code="1"
        display_key="status.sample.notStarted" is_active="Y" />
