<!-- testdata/pathology-sample.xml with the patient rows the display items
    need: PathologyDisplayService reads the case's patient through sample_human
    and renders the person's names, so a pathology case with no patient behind
    it cannot be converted at all. Case 1 holds an open request (301), case 2
    holds only a closed one (302), which is the pair the case view's request
    statuses are read against. Neither sample carries a sample_requester row,
    so both cases are ordered without a named requester. Specimen items are not
    declared here: a sample_item needs a type_of_sample, and naming that table
    in a dataset truncates it (and, through its localization, test, test_section
    and panel) for every later test class in the Surefire fork, so the case-view
    display test seeds its own type and items over this fixture instead. -->

<dataset>
    <system_user id="1001" lastupdated="2024-06-08 14:00:00.0"
        external_id="EXT001" login_name="technician1" first_name="John"
        last_name="Doe" initials="JD" is_active="Y" is_employee="Y" />
    <system_user id="1002" lastupdated="2024-06-08 14:05:00.0"
        external_id="EXT002" login_name="pathologist1" first_name="Sarah"
        last_name="Smith" initials="SS" is_active="Y" is_employee="Y" />
    <system_user id="1003" lastupdated="2024-06-08 14:05:00.0"
        external_id="EXT003" login_name="pathologist2" first_name="Mariam"
        last_name="Smith" initials="MS" is_active="Y" is_employee="Y" />
    <system_user id="1004" lastupdated="2024-06-08 14:00:00.0"
        external_id="EXT004" login_name="technician2" first_name="Kunta"
        last_name="Kinte" initials="KK" is_active="Y" is_employee="Y" />

    <person id="1" last_name="Okello" first_name="Grace"
        lastupdated="2024-06-03 12:00:00" />
    <person id="2" last_name="Abwot" first_name="Denis"
        lastupdated="2024-06-03 12:00:00" />

    <patient id="1" person_id="1" gender="F"
        birth_date="1988-04-11 00:00:00" lastupdated="2024-06-03 12:00:00" />
    <patient id="2" person_id="2" gender="M"
        birth_date="1975-09-02 00:00:00" lastupdated="2024-06-03 12:00:00" />

    <program id="1" lastupdated="2024-06-10 12:00:00.0"
        code="PROG001" name="Blood Test Program" manually_changed="false" />
    <program id="2" lastupdated="2024-06-10 12:00:00.0"
        code="PROG002" name="Blood Test2 Program" manually_changed="false" />

    <!-- The two dates differ on purpose: the case view shows the day the specimen
        arrived beside the day the examination was asked for, and two samples stamped
        on the same day cannot tell the two fields apart. Midnight is deliberate:
        it is the value a UTC formatter reads as the day before in any zone east
        of Greenwich, which is the case the display item has to get right. -->
    <sample id="1" accession_number="12345"
        received_date="2024-06-03 00:00:00.0"
        entered_date="2024-06-01 00:00:00.0"
        collection_date="2024-06-01 12:00:00.0"
        lastupdated="2023-11-01 12:00:00" />
    <sample id="2" accession_number="12346"
        received_date="2024-06-03 00:00:00.0"
        entered_date="2024-06-01 00:00:00.0"
        collection_date="2024-06-01 12:00:00.0"
        lastupdated="2023-11-01 12:00:00" />

    <sample_human id="1" samp_id="1" patient_id="1"
        lastupdated="2023-11-01 12:00:00" />
    <sample_human id="2" samp_id="2" patient_id="2"
        lastupdated="2023-11-01 12:00:00" />

    <program_sample id="1" program_id="1" sample_id="1"
        last_updated="2024-06-10 12:00:00.0" />

    <pathology_sample id="1"
        last_updated="2024-06-10 12:00:00.0" program_id="1" sample_id="1"
        technician_id="1001" pathologist_id="1002" status="GROSSING"
        gross_exam="Normal tissues observed"
        microscopy_exam="Microscopic details of sample" />
    <pathology_sample id="2"
        last_updated="2024-07-10 12:00:00.0" program_id="2" sample_id="2"
        pathologist_id="1003" status="GROSSING"
        gross_exam="Abnormal tissues observed"
        microscopy_exam="Microscopic details of sample" />

    <!-- last_updated is the row's optimistic-lock version; a child row inserted
        without one can never be updated or deleted by the application, which is
        why every pathology row here carries it. -->
    <pathology_block id="101" pathology_sample_id="1"
        last_updated="2024-06-10 12:00:00.0" block_number="11"
        location="Lab 1" />
    <pathology_slide id="201" pathology_sample_id="1"
        last_updated="2024-06-10 12:00:00.0" file_type="JPEG"
        location="Slide Storage 1" />

    <pathology_request id="301"
        last_updated="2024-06-10 12:00:00.0" pathology_sample_id="1"
        status="OPENED" type="TEXT" value="Histology review" />
    <pathology_request id="302"
        last_updated="2024-06-10 12:00:00.0" pathology_sample_id="2"
        status="COMPLETED" type="TEXT" value="Histology review" />

    <pathology_technique id="401"
        last_updated="2024-06-10 12:00:00.0" pathology_sample_id="1"
        type="TEXT" value="Frozen Section" />
    <pathology_conclusion id="501"
        last_updated="2024-06-10 12:00:00.0" pathology_sample_id="1"
        type="TEXT" value="Benign Tumor" />
    <pathology_report id="601"
        last_updated="2024-06-10 12:00:00.0" pathology_sample_id="1"
        file_type="PDF" report_type="PATHOLOGY" />
</dataset>
