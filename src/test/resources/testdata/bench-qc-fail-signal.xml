    <!-- Before the last in-control control: must NOT be linked -->
    <analysis id="9103" sampitem_id="7803" test_id="6601"
        test_sect_id="701" revision="1" status_id="1"
        started_date="2025-06-10 10:00:00"
        completed_date="2025-06-10 10:00:00" analysis_type="ROUTINE"
        type_of_sample_name="Blood" corrected="false" reflex_trigger="false"
        result_calculated="false" is_reportable="Y"
        fhir_uuid="c8b9e2c1-7a2d-4e8b-b3a4-9c1e7f6d9103"
        lastupdated="2025-06-10 10:00:00" />
    <!-- In window by time, but a different lab unit: must NOT be linked -->
    <analysis id="9104" sampitem_id="7804" test_id="6601"
        test_sect_id="702" revision="1" status_id="1"
        started_date="2025-06-10 11:50:00"
        completed_date="2025-06-10 11:50:00" analysis_type="ROUTINE"
        type_of_sample_name="Blood" corrected="false" reflex_trigger="false"
