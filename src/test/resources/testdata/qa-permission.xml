<?xml version="1.0" encoding="UTF-8"?>
<!-- Mirrors the liquibase/qa/004 permission registry: the qa.* system_module
    keys, the QA Officer role, and the grant matrix (compat grants preserve each
    surface's pre-registry audience). Loaded via the managed dataset path so
    RoleModulePermittedNamesTest is deterministic regardless of which suite tests
    truncated these tables earlier (e.g. role-module.xml). The migration's own
    execution is exercised at context start; its dev-DB content was SQL-mirror
    verified (see PR #3843). -->
