package org.openelisglobal.{module}.controller;

import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import org.openelisglobal.{module}.service.{Entity}Service;
import org.openelisglobal.{module}.valueholder.{Entity};
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;

/**
 * Component test: HTTP binding and response shape only.
 *
 * This template retains its historical filename for existing documentation links;
 * OpenELIS uses traditional Spring MVC, not Spring Boot test slices.
 * Adapt paths, required entity fields, and assertions to the actual endpoint's
 * contract. Register its real advice/converters when the behavior needs them.
 *
 * This test does not establish permissions, database writes, or service wiring.
 * Those claims require integration tests with real relevant services and filters.
 * See .specify/guides/testing-roadmap.md for level and fixture ownership rules.
 */
@RunWith(MockitoJUnitRunner.class)
public class {ControllerName}Test {
    @Mock
    private {Entity}Service {entity}Service;

    @InjectMocks
    private {ControllerName} controller;

    private MockMvc mockMvc;

    @Before
    public void setUp() {
        mockMvc = MockMvcBuilders.standaloneSetup(controller).build();
    }

    @Test
    public void getByIdReturnsTheRequestedEntity() throws Exception {
        {Entity} entity = new {Entity}();
        entity.setId("123");
        entity.setName("Requested entity");
        when({entity}Service.get("123")).thenReturn(entity);

        mockMvc.perform(get("/rest/{entities}/123"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value("123"))
                .andExpect(jsonPath("$.name").value("Requested entity"));
    }
}
