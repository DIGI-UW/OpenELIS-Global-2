{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/openelis-analyzer-candidate.schema.json",
  "title": "OpenELIS analyzer activation candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oeAnalyzerId",
    "profileRef",
    "instance",
    "siteBinding",
    "verification",
    "desiredRegistrationFingerprint",
    "bridgeAcknowledgement"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "oeAnalyzerId": { "$ref": "#/$defs/nonBlank" },
    "profileRef": { "$ref": "#/$defs/profileRef" },
    "instance": { "$ref": "#/$defs/instance" },
    "siteBinding": { "$ref": "#/$defs/siteBinding" },
    "verification": { "$ref": "#/$defs/verification" },
    "desiredRegistrationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "bridgeAcknowledgement": { "$ref": "#/$defs/bridgeAcknowledgement" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "pattern": ".*\\S.*" },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlank" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "labUnitIds", "connection"],
      "properties": {
        "name": { "$ref": "#/$defs/nonBlank" },
        "labUnitIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "connection": { "$ref": "#/$defs/connection" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "settings"],
      "properties": {
        "mode": { "enum": ["TCP", "MLLP", "SERIAL", "FILE", "HTTP"] },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "$ref": "#/$defs/nonBlank" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "serialDevice": { "$ref": "#/$defs/nonBlank" },
            "baudRate": { "type": "integer", "minimum": 1 },
            "directory": { "$ref": "#/$defs/nonBlank" },
            "credentialsRef": { "$ref": "#/$defs/nonBlank" }
          }
        }
      }
    },
    "siteBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "tests"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "tests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nonBlank" },
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/boundTest" },
              { "$ref": "#/$defs/excludedTest" }
            ]
          }
        }
      }
    },
    "boundTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "openelisTestId", "resultValues"],
      "properties": {
        "status": { "const": "BOUND" },
        "openelisTestId": { "$ref": "#/$defs/nonBlank" },
        "resultValues": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/nonBlank" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["openelisResultOptionId"],
            "properties": {
              "openelisResultOptionId": { "$ref": "#/$defs/nonBlank" }
            }
          }
        }
      }
    },
    "excludedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "EXCLUDED" },
        "reason": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedBy",
        "verifiedAt",
        "auditEventId",
        "profileRevisionFingerprint",
        "siteBindingFingerprint",
        "recognitionFingerprint"
      ],
      "properties": {
        "verifiedBy": { "$ref": "#/$defs/nonBlank" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "auditEventId": { "$ref": "#/$defs/nonBlank" },
        "profileRevisionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "siteBindingFingerprint": { "$ref": "#/$defs/fingerprint" },
        "recognitionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "bridgeAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profileRef", "desiredStateFingerprint", "acknowledgedAt"],
      "properties": {
        "status": { "const": "APPLIED" },
        "profileRef": { "$ref": "#/$defs/profileRef" },
        "desiredStateFingerprint": { "$ref": "#/$defs/fingerprint" },
        "acknowledgedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
