[Unit]
Description=Restore the deployed OpenELIS testing baseline
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
EnvironmentFile=/etc/openelis-testing-reset.conf
ExecStart=/usr/bin/python3 /usr/local/lib/openelis-testing/reset-testing.py reset ${SITE_PATH} --yes --scheduled
TimeoutStartSec=20min
